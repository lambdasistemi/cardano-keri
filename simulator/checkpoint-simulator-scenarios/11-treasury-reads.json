{
  "story": 11,
  "title": "The treasury reads Alice's checkpoint",
  "goal": "As the treasury validator, I want to authorize a payment only if Alice's keys really are current, so I read her checkpoint as a reference input.",
  "params": {
    "D": 1000,
    "B": 5,
    "P": 2,
    "W": 10
  },
  "steps": [
    {
      "slot": 0,
      "who": "treasury",
      "say": "Absent: the treasury fails closed.",
      "expect": {
        "verdict": "not-present"
      }
    },
    {
      "slot": 0,
      "who": "alice",
      "say": "Registered: juvenile for W slots.",
      "action": {
        "register": {
          "refund": 1,
          "pool0": 1
        }
      },
      "expect": {
        "ok": true,
        "verdict": "juvenile",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 10,
      "who": "treasury",
      "say": "Born at 0, W = 10: consumable at slot 10.",
      "expect": {
        "verdict": "consumable"
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "Frozen: the freeze bond is missing.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              0,
              0,
              1
            ]
          }
        ]
      },
      "action": {
        "freeze": {
          "sn'": 1,
          "payee": 2
        }
      },
      "expect": {
        "ok": true,
        "verdict": "b-missing",
        "exhibits": [
          "T1",
          "T5",
          "T6",
          "T7",
          "T9",
          "T15",
          "T16"
        ]
      }
    },
    {
      "slot": 20,
      "who": "alice",
      "say": "Unfrozen by a depositing rotation: juvenile again.",
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "deposit",
          "payee": 1,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "verdict": "juvenile",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T9",
          "T10",
          "T15"
        ]
      }
    },
    {
      "slot": 30,
      "who": "treasury",
      "say": "Consumable.",
      "expect": {
        "verdict": "consumable"
      }
    },
    {
      "slot": 30,
      "who": "alice",
      "say": "Poisoned: fails closed.",
      "evidence": {
        "add": [
          {
            "quorum": [
              1
            ]
          }
        ]
      },
      "action": "poison",
      "expect": {
        "ok": true,
        "verdict": "poisoned",
        "exhibits": [
          "T1",
          "T3",
          "T5",
          "T6",
          "T7",
          "T9",
          "T10"
        ]
      }
    },
    {
      "slot": 30,
      "who": "alice",
      "say": "Unbonded by a withdrawing rotation: the conviction bond is missing.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              1,
              1,
              2
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 2,
          "op": "withdraw",
          "payee": 1,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "verdict": "dreg-missing",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T4",
          "T5",
          "T6",
          "T7",
          "T9",
          "T14",
          "T15",
          "T16"
        ]
      }
    },
    {
      "slot": 40,
      "who": "alice",
      "say": "Bonded again: juvenile.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              2,
              2,
              3
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 3,
          "op": "deposit",
          "payee": 1,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "verdict": "juvenile",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T9",
          "T10",
          "T15"
        ]
      }
    },
    {
      "slot": 50,
      "who": "treasury",
      "say": "Consumable. What the treasury cannot know: whether Alice rotated on KERI an hour ago and no hunter has landed it yet. That is why the pool exists.",
      "expect": {
        "verdict": "consumable"
      }
    },
    {
      "slot": 50,
      "who": "cora",
      "say": "Convicted: fails closed, forever.",
      "evidence": {
        "add": [
          {
            "duplicityAt": [
              3,
              3
            ]
          }
        ]
      },
      "action": {
        "convict": {
          "payee": 3
        }
      },
      "expect": {
        "ok": true,
        "verdict": "not-present",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T9",
          "T12",
          "T16"
        ]
      }
    }
  ]
}
