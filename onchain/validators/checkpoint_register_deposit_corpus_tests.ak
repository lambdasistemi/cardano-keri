    state_policy(),
    registry_name(),
    advance_hash,
    enforcement_hash,
    entitlement_hash,
    c.network,
    d_reg,
    freeze_bond,
    premium,
    application_policy(),
    None,
    c.redeemer,
    c.own_ref,
    c.tx,
  )
}

fn run(c: Case) -> Bool {
