        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9019 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(1),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    _ -> fail @"no such request"
  }
}

