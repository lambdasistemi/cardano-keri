cabal-version: 3.4
name:          cardano-keri
version:       0.4.0
synopsis:
  Haskell library for KERI-AID identity operations and cage validator types

description:
  Pure Haskell implementation of KERI Ed25519 verification, CESR
  encoding/decoding, and PlutusData types matching the cardano-keri
  extended cage validator (AIDOwnerAuth, AIDRequestAction, AIDOnChainTokenState).

license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple

-- Committed keripy oracle fixtures, read hermetically by the unit-tests
-- Keri68OracleSpec via Paths_cardano_keri (getDataFileName).
-- #240 N-045: exact byte copies of root deploy/preprod/*.json, hermetic
-- register-preflight fixtures for CLISpec's packaged run (the offchain
-- flake's `${./.}` store source cannot contain its repository-parent
-- deploy/ directory). Named explicitly, not folded into an unrelated
-- wildcard.
data-files:
  deployment-test/fixtures/*.cesr
  deployment-test/fixtures/koios/*.cbor
  deployment-test/fixtures/koios/*.json
  deployment-test/fixtures/koios-recorded/*.json
  deployment-test/fixtures/register-preflight-board-manifest.json
  deployment-test/fixtures/register-preflight-m1-manifest.json
  deployment-test/fixtures/registry-v1/*.json
  docs/assets/swagger/query-api.json
  indexer-test/fixtures/*.json
  test/keri-fixtures/fixtures/*.json

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   lib
  build-depends:
    , base                  >=4.18 && <5
    , bytestring            >=0.11 && <0.13
