[132.765579, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mIndependent checkpoint readback\u001b[0m\r\n\r\n\u001b[0;90m# Status must name the same AID and settled registration transaction.\u001b[0m\r\n\r\n\u001b[1;32m$ ckeri status --aid EJ_VgFPrdc-VOWwvwmBMV8cU18FvP_BimhGOf9euRnsg\u001b[0m\r\n"]
