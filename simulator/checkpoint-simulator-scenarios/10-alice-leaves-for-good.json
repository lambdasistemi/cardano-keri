          "expect": {
            "ok": true,
            "live": {
              "sn": 3,
              "epoch": 3,
              "bornAt": 30,
              "dreg": 1000,
              "b": 5,
              "pool": 10,
              "refundTo": 1
            },
            "flow": {
              "dregIn": 1000,
              "bIn": 5,
              "poolIn": 10
            },
            "verdict": "juvenile",
            "exhibits": [
              "T1",
              "T10",
              "T2",
              "T3",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          }
        },
        {
          "slot": 40,
          "who": "treasury",
          "say": "Ten slots later the reopened checkpoint is consumable again.",
          "expect": {
            "verdict": "consumable"
          }
        }
      ]
