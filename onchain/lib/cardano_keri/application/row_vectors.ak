/// The key of the AID `aidE` of the Lean (its CESR text) and of `aidE2`.
pub const key_e: ByteArray =
  #"454d4d6351746f714f6b41434c767973774a54465855516d52625a68577434414c6a6a68587a4c4768723550"

pub const key_e2: ByteArray =
  #"4545426a795463564847555a4872523178337775784f7862727a48305f63476641594a4a51484d453350776f"

const datum_e: ByteArray =
  #""

const datum_e2: ByteArray =
  #""

/// The version 2 checkpoint datum of the AID `aidE` (0) or `aidE2` (1), as the
/// Lean writes it.
pub fn initial_datum(which: Int) -> Data {
  let bytes = if which == 0 {
    datum_e
  } else {
    datum_e2
  }
  expect Some(datum) = cbor.deserialise(bytes)
  datum
}

fn live_of(
  sn: Int,
  epoch: Int,
  poisoned: Bool,
  frozen: Bool,
  born_at: Int,
  refund_to: ByteArray,
  topped_up: Bool,
  keys: KeyMaterial,
) -> Data {
  expect Live { aid, .. } = datum.read(initial_datum(0))
  datum.write(
    Live {
      aid,
      sn,
      epoch,
      poisoned,
      frozen,
      born_at,
      refund_to,
      topped_up,
      keys,
    },
  )
}

/// The checkpoint datum of `aidE` in another state than the initial one, one
/// field at a time: 1 sequence number 7, 2 epoch 3, 3 poisoned, 4 frozen,
/// 5 topped up, 6 born one slot after the booking bound, 7 refunding to the other
/// address, 8 a pending termination, 9 the initial state with other key material.
pub fn variant(which: Int) -> Data {
  expect  
      Live {
        aid,
        sn,
        epoch,
        poisoned,
        frozen,
        born_at,
        refund_to,
        topped_up,
        keys,
      }
    = datum.read(initial_datum(0))
  when which is {
    1 ->
      live_of(7, epoch, poisoned, frozen, born_at, refund_to, topped_up, keys)
    2 -> live_of(sn, 3, poisoned, frozen, born_at, refund_to, topped_up, keys)
    3 -> live_of(sn, epoch, True, frozen, born_at, refund_to, topped_up, keys)
    4 -> live_of(sn, epoch, poisoned, True, born_at, refund_to, topped_up, keys)
    5 -> live_of(sn, epoch, poisoned, frozen, born_at, refund_to, True, keys)
    6 ->
      live_of(
        sn,
        epoch,
        poisoned,
        frozen,
        born_at + 1,
        refund_to,
        topped_up,
        keys,
      )
    7 ->
      live_of(
        sn,
        epoch,
        poisoned,
        frozen,
        born_at,
        bytearray.push(
          #"72777c81868b90959a9fa4a9aeb3b8bdc2c7ccd1d6dbe0e5eaeff4f9",
          96,
        ),
        topped_up,
        keys,
      )
    8 -> datum.write(TerminationPending { aid, sn: 0, epoch: 0 })
    9 ->
      live_of(
        sn,
        epoch,
        poisoned,
        frozen,
        born_at,
        refund_to,
        topped_up,
        KeyMaterial {
          ..keys,
          cur_keys: list.concat(
            keys.cur_keys,
            [
              #"0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20",
            ],
          ),
        },
      )
    _ -> fail @"no such variant"
  }
}

/// Whether the datums built here serialise back to the Lean's bytes.
pub fn datums_read_back() -> Bool {
  cbor.serialise(initial_datum(0)) == datum_e && cbor.serialise(
    initial_datum(1),
  ) == datum_e2
}

pub fn keri_registry() -> RegistryIdentity {
  RegistryIdentity { policy: cfg.state_policy, name: cfg.registry_name }
}

pub fn foreign_registry() -> RegistryIdentity {
  RegistryIdentity { policy: cfg.foreign_state_policy, name: cfg.registry_name }
}

/// The request the Lean fixture number `raw` decodes to.
pub fn request_data(raw: Int) -> RegistrationData {
  when raw is {
    9001 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9002 ->
      RegistrationData {
        registry: foreign_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9003 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(0),
        deposit: 13,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9004 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: other_address,
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9005 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 16,
        reclaim_end: 16,
      }
    9006 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(Script(cfg.application_policy)),
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9007 ->
