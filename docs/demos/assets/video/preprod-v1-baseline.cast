[8.231694, "o", "Alias: \talice\r\nIdentifier: EJ_VgFPrdc-VOWwvwmBMV8cU18FvP_BimhGOf9euRnsg\r\nSeq No:\t0\r\n\r\nWitnesses:\r\nCount:\t\t0\r\nReceipts:\t0\r\nThreshold:\t0\r\n\r\nPublic Keys:\t\r\n\t1. DNnRbxlHLFlQGSzSeJ1KB2oi9jEsWAnsoYX_tMIbDhbW\r\n\u001b[1;32m$ kli export --name alice --alias alice > inception.cesr\u001b[0m\r\n"]
[12.056093, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mAlice registers on Cardano preprod\u001b[0m\r\n\r\n\u001b[0;90m# ckeri consumes the keripy export and settles the V1 checkpoint.\u001b[0m\r\n\r\n\u001b[1;32m$ ckeri register --network preprod --kel inception.cesr\u001b[0m\r\n"]
