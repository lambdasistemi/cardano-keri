  premium, spent_ref,
}
use registry_fixture.{application_policy, registry_name, state_policy}

fn run_spend(redeemer: Data, tx: Transaction) -> Bool {
  checkpoint_register.checkpoint_register.spend(
    state_policy(),
    registry_name(),
    advance_hash,
    enforcement_hash,
    entitlement_hash,
    network_id,
    d_reg,
    freeze_bond,
    premium,
    application_policy(),
    None,
    redeemer,
    spent_ref(),
    tx,
  )
}

fn run(f: Freeze) -> Bool {
  run_spend(freeze_redeemer(f.hunter_output_index), f.tx) && checkpoint_observer.observer_advance.withdraw(
    0,
    f.observed,
    0,
    f.tx,
  )
}

