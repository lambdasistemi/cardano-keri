//// #345 — the wire shapes of the deposit option, against the Haskell encoders.
////
//// `deposit_wire_vectors` is generated by `gen-deposit-vectors` from the
//// Haskell encoders: the bytes of the Advance spend redeemer with each bond
//// option and of a deposit intent, beside the typed inputs they were built
//// from. Each test serialises the Aiken typed value and compares, so a field
//// order, a constructor index or a tuple shape that disagrees between the
//// layers fails here.

use aiken/cbor
use cardano_keri/checkpoint/deposit.{
  DepositIntent, deposit_domain, intent_bytes,
}
use cardano_keri/checkpoint/deposit_wire_vectors as vec
use checkpoint_register.{Advance, Deposit, Keep}

test advance_with_keep_is_the_haskell_encoding() {
  let redeemer: Data = Advance {
    payee_output_index: vec.payee_output_index,
    bond: Keep,
  }
  cbor.serialise(redeemer) == vec.keep_redeemer_cbor
}

test advance_with_deposit_is_the_haskell_encoding() {
  let redeemer: Data = Advance {
    payee_output_index: vec.payee_output_index,
    bond: Deposit { signatures: vec.signatures },
  }
  cbor.serialise(redeemer) == vec.deposit_redeemer_cbor
}

test deposit_intent_is_the_haskell_encoding() {
  let intent = DepositIntent {
    domain: deposit_domain,
    network_id: 1,
    checkpoint_policy: vec.policy,
    spent_ref: vec.spent_ref,
    aid: vec.aid,
    new_sn: 18_446_744_073_709_551_630,
    new_epoch: 3,
    deposit: 5_000_000,
  }
  intent_bytes(intent) == vec.intent_cbor
}
