{
  "story": 7,
  "title": "Mallory steals the current keys; Alice poisons, then rotates",
  "goal": "As Alice, when my current keys are stolen, I want every consumer to stop trusting this epoch now, before I have managed to rotate.",
  "params": {
    "D": 1000,
    "B": 5,
    "P": 2,
    "W": 10
  },
  "steps": [
    {
      "slot": 0,
      "who": "alice",
      "say": "Registered, bonded, with a short pool.",
      "action": {
        "register": {
          "refund": 1,
          "pool0": 1
        }
      },
      "expect": {
        "ok": true,
        "verdict": "juvenile",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "Mallory has the current keys. Alice's key holders sign a poison declaration at the current threshold; anyone lands it. Consumers stop trusting this epoch now.",
      "evidence": {
        "add": [
          {
            "quorum": [
              0
            ]
          }
        ]
      },
      "action": "poison",
      "expect": {
        "ok": true,
        "live": {
          "epoch": 0,
          "poisoned": true,
          "dreg": 1000,
          "b": 5,
          "pool": 1
        },
        "flow": {},
        "verdict": "poisoned",
        "exhibits": [
          "T1",
          "T3",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T10"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "Poisoning twice in one epoch is refused.",
      "action": "poison",
      "expect": {
        "ok": false,
        "reason": "already-poisoned",
        "verdict": "poisoned",
        "exhibits": [
          "T4",
          "T7",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "mallory",
      "say": "Mallory, with the stolen current keys, tries to close and take the bonds: close is disabled while poisoned.",
      "action": "close",
      "expect": {
        "ok": false,
        "reason": "poisoned",
        "verdict": "poisoned",
        "exhibits": [
          "T4",
          "T7",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "Hal holds a later witnessed rotation and the pool is short, but a poisoned checkpoint cannot be frozen: it is already unconsumable, nothing to freeze.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              0,
              0,
              1
            ]
          }
        ]
      },
      "action": {
        "freeze": {
          "sn'": 1,
          "payee": 2
        }
      },
      "expect": {
        "ok": false,
        "reason": "poisoned",
        "verdict": "poisoned",
        "exhibits": [
          "T4",
          "T7",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "friend",
      "say": "A top-up lands but changes nothing about trust: the poison stays.",
      "action": {
        "topUp": {
          "x": 5
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "poisoned": true,
          "pool": 6
        },
        "verdict": "poisoned",
        "exhibits": [
          "T1",
          "T4",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "Alice rotates with her next keys. The poison clears: it was local to the keys she just retired. Hal, or anyone, lands it and is paid.",
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "keep",
          "payee": 2,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "sn": 1,
          "epoch": 1,
          "poisoned": false,
          "dreg": 1000,
          "b": 5,
          "pool": 4
        },
        "flow": {
          "hunter": {
            "addr": 2,
            "dreg": 0,
            "b": 0,
            "pool": 2
          }
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T4",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 12,
      "who": "mallory",
      "say": "Mallory's stolen keys are epoch 0; the checkpoint is at epoch 1. They are good for nothing on chain.",
      "action": "close",
      "expect": {
        "ok": false,
        "reason": "no-quorum",
        "verdict": "consumable",
        "exhibits": [
          "T7",
          "T9"
        ]
      }
    }
  ]
}
