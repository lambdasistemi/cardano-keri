{"version": 2, "width": 80, "height": 24, "timestamp": 1790183777, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}, "title": "Cardano KERI D-04 to D-06 model rehearsal"}
[0.523924, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.524788, "o", "\u001b[1;36mD-04 to D-06 | identity model rehearsals\u001b[0m\r\n\r\n\u001b[0;90m# Alice AID 11 and numeric tokens are simulator fixtures.\u001b[0m\r\n\u001b[0;90m# No actual inception bytes, policy ID or Cardano tx is shown.\u001b[0m\r\n\r\n"]
[0.524803, "o", "\u001b[1;32m$ node demo/identity-model-rehearsal.mjs\u001b[0m\r\n"]
[0.524909, "o", "\r\n"]
[0.524971, "o", "\u001b[1;33mSources: registry story 4; checkpoint stories 2, 3, 4.\u001b[0m\r\n"]
[4.028158, "o", "\u001b[H\u001b[2J\u001b[3J"]
[4.028392, "o", "\u001b[1;36mD-04 | registration and duplicate refusal\u001b[0m\r\n"]
[4.028459, "o", "\r\n\u001b[0;90m# The registry simulator folds Alice's first request.\u001b[0m\r\n\u001b[0;90m# A second registration for the same live AID refuses.\u001b[0m\r\n\r\n\u001b[1;32m$ node simulator/registry-simulator-cli.mjs --story 4 --to-end --json\u001b[0m\r\n\r\n"]
[4.028522, "o", "\u001b[1;33mMODEL ACCEPTED: AID 11 active; token 0; checkpoint live.\u001b[0m\r\n\u001b[0;31mEXPECTED REFUSAL: already-registered\u001b[0m\r\n"]
[7.532082, "o", "\u001b[H\u001b[2J\u001b[3J"]
[7.53222, "o", "\u001b[1;36mD-05 | witnessed advance in checkpoint model\u001b[0m\r\n\r\n\u001b[0;90m# The checkpoint simulator registers, then lands a rotation.\u001b[0m\r\n\u001b[0;90m# Its pool changes from 10 to 8 model units.\u001b[0m\r\n\r\n"]
[7.532254, "o", "\u001b[1;32m$ node simulator/checkpoint-simulator-cli.mjs --story 2 --to-end --json\u001b[0m\r\n"]
[7.53228, "o", "\r\n"]
[7.5324, "o", "\u001b[1;33mMODEL ACCEPTED: sn=1\u001b[0m\r\n"]
[7.532422, "o", "\u001b[1;33mpool=8\u001b[0m\r\n"]
[11.036059, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mD-06 | short pool freezes\u001b[0m\r\n"]
[11.036208, "o", "\r\n\u001b[0;90m# The model takes a freeze branch with pool 1.\u001b[0m\r\n\u001b[0;90m# A short pool is not a blanket refusal.\u001b[0m\r\n\r\n\u001b[1;32m$ node simulator/checkpoint-simulator-cli.mjs --story 3 --to-end --json\u001b[0m\r\n\r\n"]
[11.036281, "o", "\u001b[1;33mMODEL ACCEPTED: frozen=true\u001b[0m\r\n"]
[11.036289, "o", "\u001b[1;33mpool=1\u001b[0m\r\n"]
[14.540072, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mD-06 | unpaid keep from frozen\u001b[0m\r\n"]
[14.540219, "o", "\r\n"]
[14.540275, "o", "\u001b[0;90m# The next story reaches an unpaid advance.\u001b[0m\r\n\u001b[0;90m# Sequence rises while the short pool remains at 1.\u001b[0m\r\n\r\n\u001b[1;32m$ node simulator/checkpoint-simulator-cli.mjs --story 4 --to-end --json\u001b[0m\r\n\r\n"]
[14.540302, "o", "\u001b[1;33mMODEL ACCEPTED: sn=1\u001b[0m\r\n\u001b[1;33mpool=1\u001b[0m\r\n"]
[18.044169, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mCandidate model play complete | ledger target open\u001b[0m\r\n"]
[18.044321, "o", "\r\n\u001b[0;90m# These are simulator observations from the shipped corpus.\u001b[0m\r\n"]
[18.044363, "o", "\u001b[0;90m# They do not prove CK to Singular mapping or devnet behavior.\u001b[0m\r\n\r\n\u001b[1;32m$ review the dated pages\u001b[0m\r\n\r\n\u001b[1;33mConnected scripts and node receipts remain required.\u001b[0m\r\n"]
