      "steps": [
        {
          "slot": 20,
          "who": "mallory",
          "say": "Suppose Mallory also stole the new keys and closes. The token burns, but every lovelace goes to Alice's refund address: the closer chooses when, never where.",
          "evidence": {
            "add": [
              {
                "quorum": [
                  1
                ]
              },
              {
                "rotationTo": [
                  1,
                  1,
                  2
                ]
              },
              {
                "intentAuthorized": [
                  2,
                  "close",
                  null
                ]
              }
            ]
          },
          "action": {
            "close": {
              "sn'": 2,
              "refund'": null
            }
          },
          "expect": {
            "ok": true,
            "state": {
              "closed": {
                "epoch": 2,
                "sn": 2
              }
            },
            "flow": {
              "refund": {
                "addr": 1,
                "dreg": 1000,
                "b": 5,
                "pool": 8
              }
