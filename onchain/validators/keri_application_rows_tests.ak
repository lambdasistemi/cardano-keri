/// Lean row `termination-return`: a return naming a pending termination: refused.
test row_termination_return() {
  accepts(
    requests.termination_tx(
      Termination { ..requests.termination(), redeemer: ReturnRegistration },
    ),
  ) == False
}

/// Lean approval `approval`: the registration approval of a funded registration of 15 lovelace. The preimage and the name are the Lean's, byte for byte.
test approval_has_the_lean_preimage_and_name() {
  let lean = when list.at(rows.lean_approvals, 0) is {
    Some(lean) -> lean
    None -> fail
  }
  let data = lean_request(lean)
  and {
    registration_preimage(
      data.key,
      data.registry,
      data.holding_address,
      initial_datum_hash(data.initial_datum),
      data.deposit,
    ) == lean.preimage,
    initial_datum_hash(data.initial_datum) == lean.initial_datum_hash,
    registration_approval(data) == lean.name,
    approval_name(lean.preimage) == lean.name,
  }
}

/// Lean approval `approval-other-deposit`: the same registration committing 16: another approval. The preimage and the name are the Lean's, byte for byte.
test approval_other_deposit_has_the_lean_preimage_and_name() {
  let lean = when list.at(rows.lean_approvals, 1) is {
    Some(lean) -> lean
    None -> fail
  }
  let data = lean_request(lean)
  and {
    registration_preimage(
      data.key,
      data.registry,
      data.holding_address,
      initial_datum_hash(data.initial_datum),
      data.deposit,
    ) == lean.preimage,
    initial_datum_hash(data.initial_datum) == lean.initial_datum_hash,
    registration_approval(data) == lean.name,
    approval_name(lean.preimage) == lean.name,
  }
}

/// Lean approval `approval-other-aid`: another AID in the same registry: another key, datum and approval. The preimage and the name are the Lean's, byte for byte.
test approval_other_aid_has_the_lean_preimage_and_name() {
  let lean = when list.at(rows.lean_approvals, 2) is {
    Some(lean) -> lean
    None -> fail
  }
  let data = lean_request(lean)
  and {
    registration_preimage(
      data.key,
      data.registry,
      data.holding_address,
      initial_datum_hash(data.initial_datum),
      data.deposit,
    ) == lean.preimage,
    initial_datum_hash(data.initial_datum) == lean.initial_datum_hash,
    registration_approval(data) == lean.name,
    approval_name(lean.preimage) == lean.name,
  }
}
