/// The parse refuses vector `trailing-byte` (Lean `ofBytes?`): a written datum followed by one more byte; there is no `Data` for the writer to read.
test refused_by_parse_trailing_byte() {
  cbor.deserialise(
    #"",
  ) == None
}

/// The parse refuses vector `truncated` (Lean `ofBytes?`): a written datum missing its last byte; there is no `Data` for the writer to read.
test refused_by_parse_truncated() {
  cbor.deserialise(
    #"",
  ) == None
}

/// The parse refuses vector `empty` (Lean `ofBytes?`): no bytes; there is no `Data` for the writer to read.
test refused_by_parse_empty() {
  cbor.deserialise(#"") == None
}

/// The parse refuses vector `break-byte` (Lean `ofBytes?`): a lone break byte; there is no `Data` for the writer to read.
test refused_by_parse_break_byte() {
  cbor.deserialise(#"ff") == None
}
