/// The Issue redeemer of two requests of distinct evidence.
test issue_0_has_the_vector_bytes() {
  let redeemer: Data = Issue {
    application_policy: #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
    entries: [
      BookedRequest {
        request_index: 3,
        evidence: RegistrationEvidence {
          event_bytes: #"696370",
          ctrl_sigs: [
            (
              0,
              #"a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
            ),
          ],
          wit_receipts: [
            (
              1,
              #"b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1",
            ),
          ],
        },
      },
      BookedRequest {
        request_index: 5,
        evidence: RegistrationEvidence {
          event_bytes: #"696371",
          ctrl_sigs: [
            (
              1,
              #"a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2",
            ),
            (
              2,
              #"b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2",
            ),
          ],
          wit_receipts: [],
        },
      },
    ],
  }
  builtin.serialise_data(redeemer) == #""
}

/// The Issue redeemer of one request whose event bytes are longer than 64 bytes.
test issue_1_has_the_vector_bytes() {
  let redeemer: Data = Issue {
    application_policy: #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
    entries: [
      BookedRequest {
        request_index: 300,
        evidence: RegistrationEvidence {
          event_bytes: #"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          ctrl_sigs: [
            (
              0,
              #"a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
            ),
          ],
          wit_receipts: [
            (
              1,
              #"b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1",
            ),
          ],
        },
      },
    ],
  }
  builtin.serialise_data(redeemer) == #""
}

/// The Burn redeemer.
test burn_has_the_vector_bytes() {
  let redeemer: Data = Burn
  builtin.serialise_data(redeemer) == #"d87a80"
}
