{
  "story": 10,
  "title": "Alice leaves for good",
  "goal": "As Alice, I want my identity off Cardano and my money back.",
  "params": {
    "D": 1000,
    "B": 5,
    "P": 2,
    "W": 10
  },
  "steps": [
    {
      "slot": 0,
      "who": "alice",
      "say": "Registered, bonded, pool of 10.",
      "action": {
        "register": {
          "refund": 1,
          "pool0": 10
        }
      },
      "expect": {
        "ok": true,
        "verdict": "juvenile",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "Mallory has stolen the current keys. Alice blocks the close itself by poisoning first.",
      "evidence": {
        "add": [
          {
            "quorum": [
              0
            ]
          }
        ]
      },
      "action": "poison",
      "expect": {
        "ok": true,
        "live": {
          "poisoned": true
        },
        "verdict": "poisoned",
        "exhibits": [
          "T1",
          "T10",
          "T3",
          "T4",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "mallory",
      "say": "Mallory's close is refused — not because of the poison (D-036 lets a close land poisoned) but because a close is a witnessed rotation by the next keys, which she cannot produce.",
      "action": {
        "close": {
          "sn'": 1,
          "refund'": null
        }
      },
      "expect": {
        "ok": false,
        "reason": "no-witnessed-rotation",
        "verdict": "poisoned",
        "exhibits": [
          "T7",
          "T9"
        ]
      },
      "evidence": {
        "add": []
      }
    },
    {
      "slot": 20,
      "who": "alice",
      "say": "Alice rotates to fresh keys; the poison clears.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              0,
