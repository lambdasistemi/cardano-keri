{
  "id": 9, "slug": "forever", "story": "Registration is forever",
  "narrative": "There is no close in the permissionless registry. Alice's row and token are permanent: her own request to register her AID again fails the absence proof exactly as a stranger's would, and no action in the machine removes a row. Leaving the checkpoint's economy is the checkpoint's pause, which touches no token.",
  "params": { "D": 1000, "tip": 2, "process": 10, "retract": 10 }, "plugin": 7,
  "actors": { "1": "Alice", "3": "Hal (folder)", "6": "Sam (sweeper)" },
  "env": { "inception": [11], "duplicity": [] },
  "steps": [
    { "now": 0, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 0 } }, "expect": { "ok": true } },
    { "now": 1, "actor": "anyone", "as": "Hal", "action": { "fold": { "folder": 3, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "process" }] } }, "expect": { "ok": true }, "exhibits": ["R12"] },
    { "now": 5, "actor": "proof", "as": "Cora — convicting Alice without a proof", "action": { "convict": { "aid": 11 } }, "expect": { "ok": false, "reason": "no-duplicity-proof" } },
    { "now": 6, "actor": "anyone", "as": "Alice — registering herself again", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 6 } }, "expect": { "ok": true }, "exhibits": ["R4"] },
    { "now": 7, "actor": "anyone", "as": "Hal", "action": { "fold": { "folder": 3, "gen": 1, "plugin": 7, "batch": [{ "id": 1, "do": "process" }] } }, "expect": { "ok": false, "reason": "already-registered" }, "exhibits": ["R1c"] },
    { "now": 26, "actor": "anyone", "as": "Sam", "action": { "fold": { "folder": 6, "gen": 1, "plugin": 7, "batch": [{ "id": 1, "do": "reject" }] } },
      "expect": { "ok": true, "flow": { "refunds": [{ "addr": 1, "value": 1000 }], "tips": { "addr": 6, "value": 2 } } }, "exhibits": ["R4", "R9"] }
  ],
  "expectFinal": { "gen": 2, "plugin": 7, "root": [11], "live": [11], "tomb": [], "requests": [], "nextReq": 2 }
}
