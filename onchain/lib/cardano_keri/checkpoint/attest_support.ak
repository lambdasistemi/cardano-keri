//// Test support for the two-policy advance: the mint field a spend of the checkpoint finds when the change policy ran
//// for a claim (the asset named by the digest of the claim). Used by the fixtures that assemble rotation and freeze
//// transactions; the independent names of the new tests are generated by scripts/advance-split-vectors.mjs.

use aiken/builtin
use aiken/collection/list
use aiken/crypto.{blake2b_256}
use cardano/assets.{PolicyId, Value, add, zero}
use cardano/transaction.{InlineDatum, OutputReference, Transaction, find_input}
use cardano_keri/checkpoint/advance.{AdvanceEvidence}
use cardano_keri/checkpoint/datum.{Live}
use cardano_keri/checkpoint/observer.{
  FreezeEvidence, ObserverClaim, ObserverEnvelope,
}
use cardano_keri/checkpoint/split.{SignedFact, signed_name}

type Claimed {
  tag: ByteArray,
  action: Int,
  checkpoint_policy: PolicyId,
  spent: OutputReference,
  successor_index: Int,
}

/// The name of the change attestation of a claim whose successor sits at `successor_index`.
pub fn change_name(claim: ObserverClaim, successor_index: Int) -> ByteArray {
  expect Some(spent) = claim.own_ref
  let c: Data = Claimed {
    tag: "cardano-keri/advance/v1",
    action: claim.action,
    checkpoint_policy: claim.checkpoint_policy,
    spent,
    successor_index,
  }
  blake2b_256(builtin.serialise_data(c))
}

/// The mint field holding that attestation at +1 under the change policy `advance_hash`.
pub fn change_mint(
  advance_hash: PolicyId,
  claim: ObserverClaim,
  successor_index: Int,
) -> Value {
  zero |> add(advance_hash, change_name(claim, successor_index), 1)
}

/// The fact policy's id in the fixtures that run both policies beside the spend.
pub const event_policy: PolicyId =
  #"e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1"

/// The signed fact of a freeze's rotation evidence over the spent checkpoint the claim names: the rotation's bytes,
/// the rotated current keys, threshold, witnesses and toad, the spent checkpoint's committed next keys and threshold,
/// the signatures and the receipts. A payload that is not freeze evidence has no fact.
pub fn freeze_fact(envelope: ObserverEnvelope, tx: Transaction) -> SignedFact {
  expect evidence: FreezeEvidence = envelope.payload
  expect Some(own_ref) = envelope.claim.own_ref
  expect Some(own_input) = find_input(tx.inputs, own_ref)
  expect InlineDatum(old_data) = own_input.output.datum
  expect Live { keys: old_keys, .. } = datum.read(old_data)
  let rotated = evidence.rotated_keys
  SignedFact {
    event_bytes: evidence.rotation.event_bytes,
    cur_keys: rotated.cur_keys,
    cur_threshold: rotated.cur_threshold,
    witnesses: rotated.witnesses,
    toad: rotated.toad,
    spent_next_keys: old_keys.next_keys,
    spent_next_threshold: old_keys.next_threshold,
    ctrl_sigs: evidence.rotation.ctrl_sigs,
    wit_receipts: evidence.rotation.wit_receipts,
  }
}

/// The transaction with the fact's asset at +1 added to its mint field.
pub fn with_fact(tx: Transaction, fact: SignedFact) -> Transaction {
  Transaction { ..tx, mint: add(tx.mint, event_policy, signed_name(fact), 1) }
}

/// The signed fact of an advance's (rotation or depositing rotation) evidence over the spent checkpoint the claim
/// names, the successor being the output at `successor_index`: the rotation's bytes, the successor's current keys,
/// threshold, witnesses and toad, the spent checkpoint's committed next keys and threshold, the signatures and the
/// receipts. A payload that is not advance evidence has no fact.
pub fn advance_fact(
  envelope: ObserverEnvelope,
  tx: Transaction,
  successor_index: Int,
) -> SignedFact {
  expect evidence: AdvanceEvidence = envelope.payload
  expect Some(own_ref) = envelope.claim.own_ref
  expect Some(own_input) = find_input(tx.inputs, own_ref)
  expect InlineDatum(old_data) = own_input.output.datum
  expect Live { keys: old_keys, .. } = datum.read(old_data)
  expect Some(state_output) = list.at(tx.outputs, successor_index)
  expect InlineDatum(new_data) = state_output.datum
  expect Live { keys: new_keys, .. } = datum.read(new_data)
  SignedFact {
    event_bytes: evidence.event_bytes,
    cur_keys: new_keys.cur_keys,
    cur_threshold: new_keys.cur_threshold,
    witnesses: new_keys.witnesses,
    toad: new_keys.toad,
    spent_next_keys: old_keys.next_keys,
    spent_next_threshold: old_keys.next_threshold,
    ctrl_sigs: evidence.ctrl_sigs,
    wit_receipts: evidence.wit_receipts,
  }
}
