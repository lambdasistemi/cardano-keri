[136.612515, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mAlice prepares her V1 close\u001b[0m\r\n\r\n\u001b[0;90m# The refund destination is fixed in the signed close package.\u001b[0m\r\n\r\n\u001b[1;32m$ ckeri close --aid EJ_VgFPrdc-VOWwvwmBMV8cU18FvP_BimhGOf9euRnsg --kel inception.cesr --signing-package close-package\u001b[0m\r\n"]
[137.128917, "o", "signing package: /tmp/ckeri-preprod-demo.nApvVR/close-package/close-message.cbor\r\npreimage sha256: 6c92417d844b3460587c431ca9a14a33331c94d5781764f33b94a4ddbbcd2d81\r\nspent checkpoint: 3e6d1f257b1b508bc6a41b334765a3d69f3ecf2d03514d703f8e09fba3288ee6#0\r\nrefund: 1007 tADA to addr_test1vzdqjmt98smx8my6f5uum0szghuy8ff2hep2e64a9w2pehgnv4mdx\r\n"]
