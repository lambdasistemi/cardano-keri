{
  "id": 3, "slug": "folders-race", "story": "Two folders race",
  "narrative": "Alice and Bob both post requests. Hal and Mallory each build a fold against generation 0. Hal's lands: both are registered in one transaction. Mallory's is refused as stale — on chain it fails on the spent input at no cost — and when she rebuilds against generation 1 there is nothing left to fold.",
  "params": { "D": 1000, "tip": 2, "process": 10, "retract": 10 }, "plugin": 7,
  "actors": { "1": "Alice", "2": "Bob", "3": "Hal (folder)", "4": "Mallory" },
  "env": { "inception": [11, 12], "duplicity": [] },
  "steps": [
    { "now": 0, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 0 } }, "expect": { "ok": true } },
    { "now": 0, "actor": "anyone", "as": "Bob", "action": { "contribute": { "aid": 12, "owner": 2, "submittedAt": 0 } }, "expect": { "ok": true } },
    { "now": 2, "actor": "anyone", "as": "Hal — first fold", "action": { "fold": { "folder": 3, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "process" }, { "id": 1, "do": "process" }] } },
      "expect": { "ok": true, "flow": { "locked": [{ "aid": 11, "value": 1000 }, { "aid": 12, "value": 1000 }], "tips": { "addr": 3, "value": 4 } } },
      "exhibits": ["R1", "R2", "R6", "R11"] },
    { "now": 2, "actor": "anyone", "as": "Mallory — the same fold, one block later", "action": { "fold": { "folder": 4, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "process" }, { "id": 1, "do": "process" }] } },
      "expect": { "ok": false, "reason": "stale-generation" }, "exhibits": ["R7"], "note": "Both requesters were served by Hal's fold; Mallory lost only the tips." },
    { "now": 3, "actor": "anyone", "as": "Mallory — rebuilt against generation 1", "action": { "fold": { "folder": 4, "gen": 1, "plugin": 7, "batch": [] } },
      "expect": { "ok": false, "reason": "empty-fold" }, "exhibits": ["R8"] }
  ],
  "expectFinal": { "gen": 1, "plugin": 7, "root": [12, 11], "live": [12, 11], "tomb": [], "requests": [], "nextReq": 2 }
}
