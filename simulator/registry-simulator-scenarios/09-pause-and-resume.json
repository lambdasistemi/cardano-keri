{ "id": 9, "slug": "pause-and-resume", "story": "Alice pauses and resumes without touching the registry",
  "narrative": "Alice's next keys withdraw her bonds: the checkpoint stays on chain, parked, at min-ADA, with the key state a revival must rotate from. Later a depositing rotation makes it live again. The registry leaf never changed; the indirection is the token, which survives every rotation. A pause without the next keys, and a resume of a live checkpoint, are refused.",
  "params": { "D": 1000, "tip": 2, "Mc": 4, "Mr": 1, "process": 10, "retract": 10, "W": 5, "far": 1000000000 }, "plugin": 7, "actors": { "1": "Alice", "2": "Bob", "3": "Hal (folder)", "4": "Mallory", "5": "Cora (convictor)", "6": "Sam (reaper)" }, "env": { "inception": [11], "rotationFrom": [[11, 0], [11, 1]] },
  "steps": [
    { "now": 0, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 0, "op": "register" } }, "expect": { "ok": true } },
    { "now": 1, "actor": "anyone", "as": "Hal", "action": { "fold": { "folder": 3, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "process" }] } }, "expect": { "ok": true } },
    { "now": 4, "actor": "next-keys", "as": "Alice — resuming a live checkpoint", "action": { "resume": { "aid": 11 } }, "expect": { "ok": false, "reason": "not-parked" } },
    { "now": 5, "actor": "next-keys", "as": "Alice", "action": { "pause": { "aid": 11 } },
      "expect": { "ok": true, "state": { "gen": 1, "plugin": 7, "leaves": [{ "aid": 11, "status": { "active": 0 } }], "ckpts": [{ "aid": 11, "ckpt": { "token": 0, "k": 1, "st": { "parked": 5 } } }], "requests": [], "nextReq": 1, "nextToken": 1 } }, "exhibits": ["R6", "R11", "R1"] },
    { "now": 6, "actor": "next-keys", "as": "Alice — pausing a parked checkpoint", "action": { "pause": { "aid": 11 } }, "expect": { "ok": false, "reason": "not-live" } },
    { "now": 7, "actor": "next-keys", "as": "Alice", "action": { "resume": { "aid": 11 } }, "expect": { "ok": true }, "exhibits": ["R6", "R1"] },
    { "now": 8, "actor": "next-keys", "as": "Alice — pausing again without a rotation from k=2", "action": { "pause": { "aid": 11 } }, "expect": { "ok": false, "reason": "no-rotation" } },
    { "now": 8, "actor": "proof", "as": "Cora — convicting Alice without a proof", "action": { "convictCkpt": { "aid": 11 } }, "expect": { "ok": false, "reason": "no-duplicity-proof" }, "exhibits": ["R14"] }
  ],
  "expectFinal": { "gen": 1, "plugin": 7, "leaves": [{ "aid": 11, "status": { "active": 0 } }], "ckpts": [{ "aid": 11, "ckpt": { "token": 0, "k": 2, "st": "live" } }], "requests": [], "nextReq": 1, "nextToken": 1 } }
