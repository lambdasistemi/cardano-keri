//// Parity vectors of the booking attestation, generated by
//// scripts/attestation-vectors.mjs (never edited by hand).
////
//// The claim of a booking, the name that digests it, the Issue redeemer with
//// the evidence of each request and the Burn redeemer, run through the
//// validators' own function and types. The Haskell encoder reads the same
//// vectors from offchain/test/keri-fixtures/fixtures/attestation-vectors.json.

use aiken/builtin
use cardano_keri/application/attestation.{
  BookedRequest, Burn, Issue, attestation_claim, attestation_name,
}
use cardano_keri/checkpoint/registration.{RegistrationEvidence}

/// The claim of a small datum, an index and a deposit.
test claim_0_has_the_vector_bytes() {
  builtin.serialise_data(
    attestation_claim(
      #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
      3,
      builtin.constr_data(
        1,
        [builtin.b_data(#"696e697469616c"), builtin.i_data(7)],
      ),
      1009000000,
    ),
  ) == #"d8799f582163617264616e6f2d6b6572692f626f6f6b2d726567697374726174696f6e2f7631581cc0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c003d87a9f47696e697469616c07ff1a3c241e40ff"
}

/// The name that digests it.
test claim_0_has_the_vector_name() {
  attestation_name(
    #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
    3,
    builtin.constr_data(
      1,
      [builtin.b_data(#"696e697469616c"), builtin.i_data(7)],
    ),
    1009000000,
  ) == #"4364c47043472214a864ab1e196061b4b0c00066407ec312ca2b94381e9ea934"
}

/// The claim of a wrapped initial datum.
test claim_1_has_the_vector_bytes() {
  builtin.serialise_data(
    attestation_claim(
      #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
      0,
      builtin.constr_data(
        1,
        [
          builtin.constr_data(
            0,
            [
              builtin.b_data(
                #"4441414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
              ),
              builtin.i_data(0),
              builtin.i_data(0),
              builtin.constr_data(0, []),
              builtin.constr_data(0, []),
              builtin.i_data(10),
              builtin.b_data(
                #"6077777777777777777777777777777777777777777777777777777777",
              ),
              builtin.constr_data(0, []),
              builtin.constr_data(
                0,
                [
                  builtin.list_data(
                    [
                      builtin.b_data(
                        #"1111111111111111111111111111111111111111111111111111111111111111",
                      ),
                      builtin.b_data(
                        #"1212121212121212121212121212121212121212121212121212121212121212",
                      ),
                    ],
                  ),
                  builtin.constr_data(0, [builtin.i_data(2)]),
                  builtin.list_data(
                    [
                      builtin.b_data(
                        #"1313131313131313131313131313131313131313131313131313131313131313",
                      ),
                    ],
                  ),
                  builtin.constr_data(0, [builtin.i_data(1)]),
                  builtin.list_data([]),
                  builtin.i_data(0),
                ],
              ),
            ],
          ),
        ],
      ),
      1009000000,
    ),
  ) == #""
}

/// The name that digests it.
test claim_1_has_the_vector_name() {
  attestation_name(
    #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
    0,
    builtin.constr_data(
      1,
      [
        builtin.constr_data(
          0,
          [
            builtin.b_data(
              #"4441414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
            ),
            builtin.i_data(0),
            builtin.i_data(0),
            builtin.constr_data(0, []),
            builtin.constr_data(0, []),
            builtin.i_data(10),
            builtin.b_data(
              #"6077777777777777777777777777777777777777777777777777777777",
            ),
            builtin.constr_data(0, []),
            builtin.constr_data(
              0,
              [
                builtin.list_data(
                  [
                    builtin.b_data(
                      #"1111111111111111111111111111111111111111111111111111111111111111",
                    ),
                    builtin.b_data(
                      #"1212121212121212121212121212121212121212121212121212121212121212",
                    ),
                  ],
                ),
                builtin.constr_data(0, [builtin.i_data(2)]),
                builtin.list_data(
                  [
                    builtin.b_data(
                      #"1313131313131313131313131313131313131313131313131313131313131313",
                    ),
                  ],
                ),
                builtin.constr_data(0, [builtin.i_data(1)]),
                builtin.list_data([]),
                builtin.i_data(0),
              ],
            ),
          ],
        ),
      ],
    ),
    1009000000,
  ) == #"da0ecb0a339b493430f8408a5adc941f7b7dacf9a0526cbcd8b889162fb9ca45"
}

/// The claim of a wide index and a wide deposit.
test claim_2_has_the_vector_bytes() {
  builtin.serialise_data(
    attestation_claim(
      #"c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0",
      300,
      builtin.constr_data(
        1,
        [
          builtin.constr_data(
            0,
            [
              builtin.b_data(
                #"4441414141414141414141414141414141414141414141414141414141414141414141414141414141414141",
              ),
              builtin.i_data(0),
              builtin.i_data(0),
              builtin.constr_data(0, []),
              builtin.constr_data(0, []),
              builtin.i_data(10),
              builtin.b_data(
                #"6077777777777777777777777777777777777777777777777777777777",
              ),
              builtin.constr_data(0, []),
              builtin.constr_data(
                0,
                [
                  builtin.list_data(
                    [
                      builtin.b_data(
                        #"1111111111111111111111111111111111111111111111111111111111111111",
                      ),
                      builtin.b_data(
                        #"1212121212121212121212121212121212121212121212121212121212121212",
                      ),
                    ],
                  ),
                  builtin.constr_data(0, [builtin.i_data(2)]),
                  builtin.list_data(
                    [
                      builtin.b_data(
                        #"1313131313131313131313131313131313131313131313131313131313131313",
                      ),
                    ],
                  ),
                  builtin.constr_data(0, [builtin.i_data(1)]),
                  builtin.list_data([]),
                  builtin.i_data(0),
                ],
              ),
            ],
          ),
        ],
      ),
      5000000000000,
    ),
  ) == #""
}

