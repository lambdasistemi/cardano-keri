{
  "id": 9, "slug": "close-then-return", "story": "Alice closes and later returns",
  "narrative": "Alice's current keys close her checkpoint: the token is burned and, in the same transaction, the row is deleted from the registry. Her AID is absent again, so a fresh request can be processed: she is back with a new checkpoint.",
  "params": { "D": 1000, "tip": 2, "process": 10, "retract": 10 }, "plugin": 7,
  "actors": { "1": "Alice", "3": "Hal (folder)" },
  "env": { "inception": [11], "quorum": [11], "duplicity": [] },
  "steps": [
    { "now": 0, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 0 } }, "expect": { "ok": true } },
    { "now": 1, "actor": "anyone", "as": "Hal", "action": { "fold": { "folder": 3, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "process" }] } }, "expect": { "ok": true } },
    { "now": 4, "actor": "proof", "as": "Cora — convicting Alice without a proof", "action": { "convict": { "aid": 11 } }, "expect": { "ok": false, "reason": "no-duplicity-proof" } },
    { "now": 5, "actor": "current-quorum", "as": "Alice", "action": { "close": { "aid": 11 } },
      "expect": { "ok": true, "state": { "gen": 2, "plugin": 7, "root": [], "live": [], "tomb": [], "requests": [], "nextReq": 1 } }, "exhibits": ["R4", "R6", "R12", "R11"] },
    { "now": 6, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 6 } }, "expect": { "ok": true } },
    { "now": 7, "actor": "anyone", "as": "Hal", "action": { "fold": { "folder": 3, "gen": 2, "plugin": 7, "batch": [{ "id": 1, "do": "process" }] } }, "expect": { "ok": true }, "exhibits": ["R4", "R1", "R2"] }
  ],
  "expectFinal": { "gen": 3, "plugin": 7, "root": [11], "live": [11], "tomb": [], "requests": [], "nextReq": 2 }
}
