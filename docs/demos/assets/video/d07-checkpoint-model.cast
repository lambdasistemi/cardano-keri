{"version": 2, "width": 80, "height": 24, "timestamp": 1790185153, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}, "title": "Cardano KERI d07 checkpoint model rehearsal"}
[0.770404, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.771215, "o", "\u001b[1;36mD-07 | checkpoint model only\u001b[0m\r\n\r\n\u001b[0;90m# Stories 5, 6, 9 and 10 are shipped simulator fixtures.\u001b[0m\r\n\u001b[0;90m# No CK registry transaction or KERI proof bytes are exercised.\u001b[0m\r\n\r\n\u001b[1;32m$ node demo/later-model-rehearsal.mjs d07\u001b[0m\r\n\r\n\u001b[1;33mInputs: D=1000, B=5, P=2; addresses 1, 2, 3 are synthetic.\u001b[0m\r\n"]
[4.274012, "o", "\u001b[H\u001b[2J\u001b[3J"]
[4.274262, "o", "\u001b[1;36mClose | witnessed rotation and signed intent\u001b[0m\r\n"]
[4.274362, "o", "\r\n\u001b[0;90m# Story 5 registers, adds rotation and close intent, then closes.\u001b[0m\r\n\u001b[0;90m# This is a model transition from a live checkpoint.\u001b[0m\r\n\r\n\u001b[1;32m$ node simulator/checkpoint-simulator-cli.mjs --story 5 --to-end --json\u001b[0m\r\n\r\n"]
[4.274378, "o", "\u001b[1;33mMODEL: parked epoch=1 sn=1\u001b[0m\r\n\u001b[1;33mRefund addr 1: D=1000 B=5 pool=8\u001b[0m\r\n\u001b[1;33mHunter addr 2: premium=2\u001b[0m\r\n"]
[7.778247, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mClose refusals | authority and rotation\u001b[0m\r\n"]
[7.778535, "o", "\r\n\u001b[0;90m# A public rotation alone cannot authorize a close.\u001b[0m\r\n\u001b[0;90m# Current keys cannot substitute for witnessed next keys.\u001b[0m\r\n\r\n\u001b[1;32m$ checkpoint CLI: story 5 --fork relayer; story 10 --fork current-keys\u001b[0m\r\n\r\n"]
[7.778623, "o", "\u001b[0;31mEXPECTED REFUSAL: intent-not-authorized\u001b[0m\r\n\u001b[0;31mEXPECTED REFUSAL: no-witnessed-rotation\u001b[0m\r\n"]
[11.280186, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mReturn | parked is not terminal\u001b[0m\r\n"]
[11.280369, "o", "\r\n\u001b[0;90m# Story 6 reopens only with a later witnessed rotation.\u001b[0m\r\n\u001b[0;90m# A replay of the closing rotation fails.\u001b[0m\r\n\r\n\u001b[1;32m$ checkpoint CLI: story 6; story 6 --fork replay\u001b[0m\r\n\r\n"]
[11.280442, "o", "\u001b[1;33mMODEL: reopened epoch=2 sn=2\u001b[0m\r\n\u001b[0;31mEXPECTED REFUSAL: no-witnessed-rotation\u001b[0m\r\n"]
[14.783892, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mConviction | separate model trace\u001b[0m\r\n"]
[14.784074, "o", "\r\n\u001b[0;90m# Story 9 registers, poisons and supplies duplicityAt[0,0].\u001b[0m\r\n"]
[14.784122, "o", "\u001b[0;90m# The predicate is abstract; this is not KERI proof validation.\u001b[0m\r\n\r\n\u001b[1;32m$ node simulator/checkpoint-simulator-cli.mjs --story 9 --to-end --json\u001b[0m\r\n\r\n\u001b[1;33mMODEL: convicted; Cora addr 3 receives D=1000\u001b[0m\r\n\u001b[1;33mRefund addr 1 receives B=5 pool=10\u001b[0m\r\n"]
[18.285036, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mConviction refusals | proof and finality\u001b[0m\r\n\r\n\u001b[0;90m# Without the model duplicity atom, conviction refuses.\u001b[0m\r\n"]
[18.285077, "o", "\u001b[0;90m# A subsequent transition from convicted also refuses.\u001b[0m\r\n\r\n\u001b[1;32m$ checkpoint CLI: story 9 --fork noproof; --fork terminal\u001b[0m\r\n\r\n"]
[18.28524, "o", "\u001b[0;31mEXPECTED REFUSAL: no-duplicity-proof\u001b[0m\r\n\u001b[0;31mEXPECTED REFUSAL: convicted-terminal\u001b[0m\r\n"]
[21.788968, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mD-07 model play complete | connected target open\u001b[0m\r\n"]
[21.789021, "o", "\r\n\u001b[0;90m# Registry leaf/token, KERI duplicity and real refunds need receipts.\u001b[0m\r\n\r\n\u001b[1;32m$ review docs/demos/d07-close-convict.md\u001b[0m\r\n"]
[21.789042, "o", "\r\n"]
[21.789396, "o", "\u001b[1;33mNo ledger close or conviction is claimed.\u001b[0m\r\n"]
