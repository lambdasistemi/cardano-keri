//// #591: the abandonment rotation (a rotation that publishes no next keys), through the advance predicate and
//// through the two policies' checks of the attested generation.
////
//// R01 and R17 are the events of #589's keripy 1.3.5 corpus (branch `test/589-keripy-admission-corpus` at
//// e07714d5, generated by its `advance.py` from `evidence/keripy-results.json`): signed by keripy's own key
//// material, offsets read from the signed bytes. R01 is the ordinary 2-of-2 rotation (the control), R17 the same
//// shape rotating to an empty next commitment with next threshold 0, which keripy persists and the Lean
//// `rotationValid` admits. A state that published no next keys has nothing to reveal: Lean's `signingValid`
//// requires `!prior.nextKeys.isEmpty`, so a later rotation from empty commitments stays refused, and the
//// refusal is shown against the same event judged against a spent state whose commitments are intact.

use cardano_keri/checkpoint/advance.{
  AE6NextKeysMismatch, AE7NextThresholdMismatch, AdvEventBinding,
  AdvMessageInvalid, AdvanceEventInvalid, AdvanceEventValid, AdvanceEvidence,
  AdvancePredicateInvalid, AdvancePredicateValid, RotationBody,
  advance_predicate, event_binding, read_rotation_body,
}
use cardano_keri/checkpoint/datum.{
  CesrAidWidth, DatumInvalid, DatumValid, KeyStateView, NextIllFormed,
  key_state_after_rotation_well_formed, key_state_well_formed,
}
use cardano_keri/checkpoint/january_591_expected as expected
use cardano_keri/checkpoint/message.{
  Eq6PriorNextQuorumUnsatisfied, SpentCheckpoint, deriveAidAssetName,
}
use cardano_keri/checkpoint/split.{SignedFact, signed_ok, transition_ok}
use cardano_keri/checkpoint/threshold.{EmptyKeys, Unweighted, Weighted}

fn r01_rotation() -> (SpentCheckpoint, KeyStateView, AdvanceEvidence) {
  let spent = SpentCheckpoint {
    network_id: 0,
    policy_id: #"00",
    aid_asset_name: deriveAidAssetName(
      #"ab68a1b450d5563c1087a783a3082305703f2993a8f83867e697814ad23a8479",
    ),
    txid: #"00",
    index: 0,
    cesr_aid: #"ab68a1b450d5563c1087a783a3082305703f2993a8f83867e697814ad23a8479",
    witnesses: [],
    next_keys: [
      #"159c3bc9911dd9aedd6638b865903555f2e48b4cec27d467555c1a4156cf3feb",
      #"31b8a3406dea8fb3539432a243694f1b41ebc8acd14c1eac2a77c1de164278ef",
    ],
    next_threshold: Unweighted(2),
    seq: 0,
    native_sn: 0,
  }

  let new = KeyStateView {
    cesr_aid: #"ab68a1b450d5563c1087a783a3082305703f2993a8f83867e697814ad23a8479",
    cur_keys: [
      #"51475eed824f9a139c8f5f5996b024c9fd2c04585885e0bbd4a1eb38e14408da",
      #"e676584af4e1ed0d499c0796260474eac80a467c5769abfc57db611dcc7637fd",
    ],
    cur_threshold: Unweighted(2),
    next_keys: [
      #"1fb797ecc3540e2f7136e087c199731482c51734462c48e8b769ab5f80b1c965",
      #"95c7377259009201e3f8bfc8416290148a611b48689fb6f6725a1eb41c841489",
    ],
    next_threshold: Unweighted(2),
    witnesses: [],
    toad: 0,
    seq: 1,
    native_sn: 1,
  }

  let e = AdvanceEvidence {
    event_bytes: #"",
    off_t: 30,
    off_i: 91,
    off_s: 142,
    off_k: [211, 258],
    off_kt: 202,
    off_n: [320, 367],
    off_nt: 311,
    off_br: [],
    off_ba: [],
    off_bt: 420,
    wit_cut: [],
    wit_add: [],
    ctrl_sigs: [
      (
        0,
        #"2be4f855607bc7db021b2d7664e28d5909a61660dd2b2b1f0db52195f7bf11285a23f84a596f7d72ea1e622ae2db8697ca3cb056a491e8501b893aeafef87e06",
      ),
      (
        1,
        #"26584b9a3e1035360756165e73aab382a8f07afd356bdb2b55ca0456ba8f6b0beb9fd0a9fb5bf3a839a7b826a3136e06d11578dee3a36698af03588ae8c1660b",
      ),
    ],
    wit_receipts: [],
  }

  (spent, new, e)
}

fn r17_abandonment() -> (SpentCheckpoint, KeyStateView, AdvanceEvidence) {
  let spent = SpentCheckpoint {
    network_id: 0,
    policy_id: #"00",
    aid_asset_name: deriveAidAssetName(
      #"bbb73ed20802ffdc8ed8b5079e8567339911d8346ee279192d547d1879ef26e4",
    ),
    txid: #"00",
    index: 0,
    cesr_aid: #"bbb73ed20802ffdc8ed8b5079e8567339911d8346ee279192d547d1879ef26e4",
    witnesses: [],
    next_keys: [
      #"7de34f308bac326a6d07bfcdfcc4a69fcbe8507cc0edbc486b97e80a3d859c44",
      #"3a2f8dc158985de3f96f5e2d18683f44239264d24d985f246441ac097fe32e08",
    ],
    next_threshold: Unweighted(2),
    seq: 0,
    native_sn: 0,
  }

  let new = KeyStateView {
    cesr_aid: #"bbb73ed20802ffdc8ed8b5079e8567339911d8346ee279192d547d1879ef26e4",
    cur_keys: [
      #"19eb7d4d456cacf26dd6475a43dbeafc3e44cf93651c716c10c2578763affa6c",
      #"467f0200e5ac1101ba17354b65245ca639e247f2c2e9b4f197eb42bdd8c64ecb",
    ],
    cur_threshold: Unweighted(2),
    next_keys: [],
    next_threshold: Unweighted(0),
    witnesses: [],
    toad: 0,
    seq: 1,
    native_sn: 1,
  }

  let e = AdvanceEvidence {
    event_bytes: #"",
    off_t: 30,
    off_i: 91,
    off_s: 142,
    off_k: [211, 258],
    off_kt: 202,
    off_n: [],
    off_nt: 311,
    off_br: [],
    off_ba: [],
    off_bt: 327,
    wit_cut: [],
    wit_add: [],
    ctrl_sigs: [
      (
        0,
        #"658a191d717b6b3a5c677c6913ab891edc1c6c7c053c3177396fc65aee167914b744e7d4a2445d33f09b294b54cad2950aede5ca387dffc30fd10a5d4f41f105",
      ),
      (
        1,
        #"2cd7bea3e2e35e84c3eb803a10575f5abe5e602b922180a696b99af06a34fb9b890eea015756de0a4cc33adc00c9722950035a8deb244b11d35aecb588f08605",
      ),
    ],
    wit_receipts: [],
  }

  (spent, new, e)
}

fn without_commitments(spent: SpentCheckpoint) -> SpentCheckpoint {
  SpentCheckpoint { ..spent, next_keys: [], next_threshold: Unweighted(0) }
}

fn fact_of(
  spent: SpentCheckpoint,
  new: KeyStateView,
  e: AdvanceEvidence,
) -> SignedFact {
  SignedFact {
    event_bytes: e.event_bytes,
    cur_keys: new.cur_keys,
    cur_threshold: new.cur_threshold,
    witnesses: new.witnesses,
    toad: new.toad,
    spent_next_keys: spent.next_keys,
    spent_next_threshold: spent.next_threshold,
    ctrl_sigs: e.ctrl_sigs,
    wit_receipts: e.wit_receipts,
  }
}

// ---- the advance predicate (the observer-era and the shared message check)

test the_ordinary_rotation_is_admitted_r01() {
  let (spent, new, e) = r01_rotation()
  advance_predicate(spent, new, e) == AdvancePredicateValid
}

test the_abandonment_rotation_is_admitted_r17() {
  let (spent, new, e) = r17_abandonment()
  advance_predicate(spent, new, e) == AdvancePredicateValid
}

test a_later_rotation_from_empty_commitments_is_refused() {
  let (spent, new, e) = r01_rotation()
  advance_predicate(without_commitments(spent), new, e) == AdvancePredicateInvalid(
    AdvMessageInvalid(Eq6PriorNextQuorumUnsatisfied),
  )
}

// ---- the two policies' checks of the attested generation

test the_signed_fact_of_the_ordinary_rotation_holds_r01() {
  let (spent, new, e) = r01_rotation()
  signed_ok(fact_of(spent, new, e)) && transition_ok(spent, new, e)
}

test the_signed_fact_of_the_abandonment_rotation_holds_r17() {
  let (spent, new, e) = r17_abandonment()
  signed_ok(fact_of(spent, new, e)) && transition_ok(spent, new, e)
}

test no_fact_follows_empty_commitments() {
  let (spent, new, e) = r01_rotation()
  !signed_ok(fact_of(without_commitments(spent), new, e))
}

// ---- the created state

test a_rotation_may_create_a_state_without_next_keys_and_threshold_zero() {
  let (_, new, _) = r17_abandonment()
  key_state_after_rotation_well_formed(new) == DatumValid
}

test registration_still_requires_next_keys() {
  let (_, new, _) = r17_abandonment()
  key_state_well_formed(new) == DatumInvalid(NextIllFormed(EmptyKeys))
}

test no_next_keys_with_a_positive_threshold_stay_ill_formed() {
  let (_, new, _) = r17_abandonment()
  key_state_after_rotation_well_formed(
    KeyStateView { ..new, next_threshold: Unweighted(1) },
  ) == DatumInvalid(NextIllFormed(EmptyKeys))
}

test no_next_keys_with_a_weighted_threshold_stay_ill_formed() {
  let (_, new, _) = r17_abandonment()
  key_state_after_rotation_well_formed(
    KeyStateView { ..new, next_threshold: Weighted([]) },
  ) == DatumInvalid(NextIllFormed(EmptyKeys))
}

test an_abandonment_still_needs_current_keys() {
  let (_, new, _) = r17_abandonment()
  key_state_after_rotation_well_formed(KeyStateView { ..new, cur_keys: [] }) != DatumValid
}

test an_abandonment_still_needs_its_aid() {
  let (_, new, _) = r17_abandonment()
  key_state_after_rotation_well_formed(KeyStateView { ..new, cesr_aid: #"00" }) == DatumInvalid(
    CesrAidWidth,
  )
}

// ---- the next commitment is the rotation's own `n` and `nt` declaration (field agreement)
//
// A prover supplies the offsets. The next keys and threshold a successor claims must be what the signed body
// declares in its top-level `nt` and `n` fields, not whatever the body spells at the offsets given.

test an_abandonment_over_a_signed_event_that_declares_commitments_is_refused_by_the_predicate() {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView {
    ..new,
    next_keys: [],
    next_threshold: Unweighted(0),
  }
  // the body of R01 declares two commitments and threshold 2; its `bt` value spells 0 as well
  let steered = AdvanceEvidence { ..e, off_n: [], off_nt: e.off_bt }
  advance_predicate(spent, claimed, steered) == AdvancePredicateInvalid(
    AdvEventBinding(AE6NextKeysMismatch),
  )
}

test an_abandonment_over_a_signed_event_that_declares_commitments_is_refused_by_the_transition() {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView {
    ..new,
    next_keys: [],
    next_threshold: Unweighted(0),
  }
  let steered = AdvanceEvidence { ..e, off_n: [], off_nt: e.off_bt }
  // the signatures and the revealed commitments hold: the refusal is the change policy's
  signed_ok(fact_of(spent, claimed, steered)) && !transition_ok(
    spent,
    claimed,
    steered,
  )
}

test commitments_that_the_signed_abandonment_does_not_declare_are_refused_by_the_predicate() {
  let (spent, new, e) = r17_abandonment()
  // R17 declares none; its `p` repeats the identifier and its `s` spells 1
  let claimed = KeyStateView {
    ..new,
    next_keys: [new.cesr_aid],
    next_threshold: Unweighted(1),
  }
  let steered = AdvanceEvidence { ..e, off_n: [e.off_i], off_nt: e.off_s }
  advance_predicate(spent, claimed, steered) == AdvancePredicateInvalid(
    AdvEventBinding(AE6NextKeysMismatch),
  )
}

test commitments_that_the_signed_abandonment_does_not_declare_are_refused_by_the_transition() {
  let (spent, new, e) = r17_abandonment()
  let claimed = KeyStateView {
    ..new,
    next_keys: [new.cesr_aid],
    next_threshold: Unweighted(1),
  }
  let steered = AdvanceEvidence { ..e, off_n: [e.off_i], off_nt: e.off_s }
  signed_ok(fact_of(spent, claimed, steered)) && !transition_ok(
    spent,
    claimed,
    steered,
  )
}

// The threshold is the honest one: only the digests claimed as `n` differ from what the body declares. R01's
// signed event declares two digests; the claim names its own `i` (a digest the body repeats at offset 91) and its
// own `d` (offset 40) instead.
fn borrowed_digests() -> (KeyStateView, AdvanceEvidence, SpentCheckpoint) {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView {
    ..new,
    next_keys: [
      new.cesr_aid,
      #"5e4052e1a0b7277ec4033a8bb7880f97e4d75ce20b0189f62da0561521cc4858",
    ],
  }
  (claimed, AdvanceEvidence { ..e, off_n: [91, 40] }, spent)
}

test digests_the_body_repeats_elsewhere_cannot_stand_for_its_n_in_the_predicate() {
  let (claimed, steered, spent) = borrowed_digests()
  advance_predicate(spent, claimed, steered) == AdvancePredicateInvalid(
    AdvEventBinding(AE6NextKeysMismatch),
  )
}

test digests_the_body_repeats_elsewhere_cannot_stand_for_its_n_in_the_transition() {
  let (claimed, steered, spent) = borrowed_digests()
  signed_ok(fact_of(spent, claimed, steered)) && !transition_ok(
    spent,
    claimed,
    steered,
  )
}

// ---- the structural read of the signed body: the unique top-level `nt` and `n`, one read for both paths

fn r01_projection() -> RotationBody {
  RotationBody {
    nt_start: expected.r01_nt_start,
    nt_value: expected.r01_nt_value,
    n_starts: expected.r01_n_starts,
    n_values: expected.r01_n_values,
  }
}

test the_read_gives_the_declared_fields_of_r01() {
  read_rotation_body(expected.r01_body) == Some(r01_projection())
}

test the_read_gives_the_declared_fields_of_r17() {
  read_rotation_body(expected.r17_body) == Some(
    RotationBody {
      nt_start: expected.r17_nt_start,
      nt_value: expected.r17_nt_value,
      n_starts: expected.r17_n_starts,
      n_values: expected.r17_n_values,
    },
  )
}

test a_seal_that_spells_other_fields_does_not_change_the_read() {
  read_rotation_body(expected.nested_seal_body) == Some(r01_projection())
}

test a_body_outside_the_supported_profile_has_no_read() {
  read_rotation_body(expected.spaced_body) == None
}

test a_body_that_repeats_a_field_has_no_read() {
  read_rotation_body(expected.repeated_nt_body) == None
}

fn nested_seal_evidence(e: AdvanceEvidence) -> AdvanceEvidence {
  AdvanceEvidence { ..e, event_bytes: expected.nested_seal_body }
}

test the_declared_commitments_are_bound_in_a_body_whose_seal_spells_other_fields() {
  let (_, new, e) = r01_rotation()
  event_binding(new, nested_seal_evidence(e)) == AdvanceEventValid
}

test an_abandonment_spelled_by_a_seal_is_not_the_declared_commitment_for_the_binding() {
  let (_, new, e) = r01_rotation()
  let claimed = KeyStateView {
    ..new,
    next_keys: [],
    next_threshold: Unweighted(0),
  }
  let spelled = AdvanceEvidence {
    ..nested_seal_evidence(e),
    off_n: [],
    off_nt: expected.nested_seal_off_nt,
    off_bt: expected.nested_seal_off_bt,
  }
  event_binding(claimed, spelled) == AdvanceEventInvalid(AE6NextKeysMismatch)
}

test an_abandonment_spelled_by_a_seal_is_not_the_declared_commitment_for_the_transition() {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView {
    ..new,
    next_keys: [],
    next_threshold: Unweighted(0),
  }
  let spelled = AdvanceEvidence {
    ..nested_seal_evidence(e),
    off_n: [],
    off_nt: expected.nested_seal_off_nt,
    off_bt: expected.nested_seal_off_bt,
  }
  transition_ok(spent, new, nested_seal_evidence(e)) && !transition_ok(
    spent,
    claimed,
    spelled,
  )
}

// A threshold the body does not declare, spelled where an honest `s` value sits, with the digests as declared.
test a_threshold_the_body_does_not_declare_is_refused_by_the_predicate() {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView { ..new, next_threshold: Unweighted(1) }
  let steered = AdvanceEvidence { ..e, off_nt: e.off_s }
  advance_predicate(spent, claimed, steered) == AdvancePredicateInvalid(
    AdvEventBinding(AE7NextThresholdMismatch),
  )
}

test a_threshold_the_body_does_not_declare_is_refused_by_the_transition() {
  let (spent, new, e) = r01_rotation()
  let claimed = KeyStateView { ..new, next_threshold: Unweighted(1) }
  let steered = AdvanceEvidence { ..e, off_nt: e.off_s }
  signed_ok(fact_of(spent, claimed, steered)) && !transition_ok(
    spent,
    claimed,
    steered,
  )
}

// ---- the whole body is one object: its last member is consumed and its closing brace is the last byte

test a_repeated_declaration_after_the_last_member_has_no_read() {
  read_rotation_body(expected.trailing_pair_body) == None
}

test an_unclosed_last_member_has_no_read() {
  read_rotation_body(expected.unbalanced_a_body) == None
}

test a_second_closing_brace_has_no_read() {
  read_rotation_body(expected.trailing_brace_body) == None
}

test a_seal_with_an_escaped_quote_is_framed_and_the_read_is_the_declared_one() {
  read_rotation_body(expected.escaped_seal_body) == Some(r01_projection())
}

test a_body_with_a_repeated_declaration_after_a_is_not_bound_by_the_binder() {
  let (_, new, e) = r01_rotation()
  event_binding(
    new,
    AdvanceEvidence { ..e, event_bytes: expected.trailing_pair_body },
  ) == AdvanceEventInvalid(AE6NextKeysMismatch)
}

test a_body_with_a_repeated_declaration_after_a_is_not_a_valid_transition() {
  let (spent, new, e) = r01_rotation()
  transition_ok(spent, new, nested_seal_evidence(e)) && !transition_ok(
    spent,
    new,
    AdvanceEvidence { ..e, event_bytes: expected.trailing_pair_body },
  )
}

// ---- the value of the last member is complete compact JSON: numbers and strings follow their grammar

test valid_numbers_in_the_last_member_are_framed() {
  read_rotation_body(expected.valid_numbers_body) == Some(r01_projection())
}

test valid_escapes_in_the_last_member_are_framed() {
  read_rotation_body(expected.valid_escapes_body) == Some(r01_projection())
}

test a_minus_sign_without_digits_has_no_read() {
  read_rotation_body(expected.minus_only_body) == None
}

test a_fraction_without_digits_has_no_read() {
  read_rotation_body(expected.fraction_without_digits_body) == None
}

test an_exponent_without_digits_has_no_read() {
  read_rotation_body(expected.exponent_without_digits_body) == None
}

test a_signed_point_without_an_integer_part_has_no_read() {
  read_rotation_body(expected.signed_point_body) == None
}

test a_number_with_a_leading_zero_has_no_read() {
  read_rotation_body(expected.leading_zero_body) == None
}

test an_invalid_escape_has_no_read() {
  read_rotation_body(expected.invalid_escape_body) == None
}

test a_unicode_escape_without_four_digits_has_no_read() {
  read_rotation_body(expected.short_unicode_escape_body) == None
}

test a_raw_control_character_in_a_string_has_no_read() {
  read_rotation_body(expected.raw_control_body) == None
}

test a_body_with_a_malformed_final_value_is_not_bound_by_the_binder() {
  let (_, new, e) = r01_rotation()
  event_binding(
    new,
    AdvanceEvidence { ..e, event_bytes: expected.minus_only_body },
  ) == AdvanceEventInvalid(AE6NextKeysMismatch)
}

test a_body_with_a_malformed_final_value_is_not_a_valid_transition() {
  let (spent, new, e) = r01_rotation()
  transition_ok(
    spent,
    new,
    AdvanceEvidence { ..e, event_bytes: expected.valid_numbers_body },
  ) && !transition_ok(
    spent,
    new,
    AdvanceEvidence { ..e, event_bytes: expected.minus_only_body },
  )
}
