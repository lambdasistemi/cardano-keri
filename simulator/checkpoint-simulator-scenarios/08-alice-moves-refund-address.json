{
  "story": 8,
  "title": "Alice moves her refund address",
  "goal": "As Alice, I want the money to come back to me and not to whoever registered my checkpoint.",
  "params": {
    "D": 1000,
    "B": 5,
    "P": 2,
    "W": 10
  },
  "steps": [
    {
      "slot": 0,
      "who": "friend",
      "say": "A stranger registered Alice’s checkpoint with his own refund address (6).",
      "action": {
        "register": {
          "refund": 6,
          "pool0": 10
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "refundTo": 6
        },
        "verdict": "juvenile",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "Alice rotates on KERI. A relayer submits her public rotation asking to move the refund address to Alice’s: the new keys did not sign the address, so the rotation is refused as submitted.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              0,
              0,
              1
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "keep",
          "payee": 2,
          "refund'": 1
        }
      },
      "expect": {
        "ok": false,
        "reason": "refund-not-authorized",
        "verdict": "consumable",
        "exhibits": [
          "T7",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "The same relayer submits the rotation with no address at all: it lands, and the refund address stays the stranger’s.",
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "keep",
          "payee": 2,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "sn": 1,
          "epoch": 1,
          "refundTo": 6,
          "dreg": 1000,
          "b": 5,
          "pool": 8
        },
        "flow": {
          "hunter": {
            "addr": 2,
            "dreg": 0,
            "b": 0,
            "pool": 2
          }
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "At her next rotation Alice’s new keys (epoch 2) sign her address along with the rotation. The address moves.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              1,
              1,
              2
            ]
          },
          {
            "refundAuthorized": [
              2,
              1
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 2,
          "op": "keep",
          "payee": 1,
          "refund'": 1
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "sn": 2,
          "epoch": 2,
          "refundTo": 1,
          "dreg": 1000,
          "b": 5,
          "pool": 6
        },
        "flow": {
          "hunter": {
            "addr": 1,
            "dreg": 0,
            "b": 0,
            "pool": 2
          }
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "At close the stranger’s bonds go to Alice: a stale registration is a donation.",
      "evidence": {
        "add": [
          {
            "quorum": [
              2
            ]
          }
        ]
      },
      "action": "close",
      "expect": {
        "ok": true,
        "state": "gone",
        "flow": {
          "refund": {
            "addr": 1,
            "dreg": 1000,
            "b": 5,
            "pool": 6
          }
        },
        "verdict": "not-present",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T10",
          "T16"
        ]
      }
    }
  ]
}
