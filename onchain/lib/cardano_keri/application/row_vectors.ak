        initial_datum: initial_datum(0),
        deposit: 14,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9008 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address: pointer_refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: initial_datum(0),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9011 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(1),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9012 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(2),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9013 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(3),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9014 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(4),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9015 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(5),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9016 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(6),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
      }
    9017 ->
      RegistrationData {
        registry: keri_registry(),
        key: key_e,
        controller: #"00000000000000000000000000000000000000000000000000000000",
        refund_address,
        holding_address: held.address_of(cfg.checkpoint_credential),
        initial_datum: variant(7),
        deposit: 15,
        booked_at: 10,
        process_deadline: 15,
        reclaim_end: 15,
