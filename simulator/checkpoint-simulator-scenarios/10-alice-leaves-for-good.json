      },
      "expect": {
        "ok": true,
        "live": {
          "epoch": 1,
          "poisoned": false,
          "pool": 8
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T4",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 20,
      "who": "alice",
      "say": "Alice's next keys sign the close intent along with the rotation. The chain pays everything to the refund address and burns the token; the registry leaf keeps the tombstone (epoch 2, sequence 2).",
      "evidence": {
        "add": [
          {
            "quorum": [
              1
            ]
          },
          {
            "rotationTo": [
              1,
              1,
              2
            ]
          },
          {
            "intentAuthorized": [
              2,
              "close",
              null
            ]
          }
        ]
      },
      "action": {
        "close": {
          "sn'": 2,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "state": {
          "closed": {
            "epoch": 2,
            "sn": 2
          }
        },
        "flow": {
          "refund": {
            "addr": 1,
            "dreg": 1000,
            "b": 5,
            "pool": 8
          }
        },
        "verdict": "not-present",
        "exhibits": [
          "T1",
          "T16",
          "T2",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 20,
      "who": "friend",
      "say": "A registration is refused: the registry leaf is closed, not absent. The AID is not gone for good — only a reopen, a witnessed rotation later than the tombstone, brings it back (D-036).",
      "action": {
        "register": {
          "refund": 1,
          "pool0": 10
        }
      },
      "expect": {
        "ok": false,
        "reason": "closed-needs-reopen",
        "verdict": "not-present",
        "exhibits": [
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 20,
      "who": "friend",
      "say": "Nothing else lands on a tombstone: no top-up, no rotation, no poison. Reopen or nothing.",
      "action": {
        "topUp": {
          "x": 1
        }
      },
      "expect": {
        "ok": false,
        "reason": "closed-needs-reopen",
        "verdict": "not-present",
        "exhibits": [
          "T7",
          "T8",
          "T9"
        ]
      }
    }
  ],
  "forks": [
    {
