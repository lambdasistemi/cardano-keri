{
  "id": 6, "slug": "permissionless-sweep", "story": "Nobody folds and Alice missed phase 2; Sam sweeps",
  "narrative": "The request passed phase 2 unretracted. Under an owner-keyed cage it would now be stranded; here anyone can reject it: Sam spends the registry with a batch of one reject, Alice's bond goes back to her, Sam takes the tip.",
  "params": { "D": 1000, "tip": 2, "process": 10, "retract": 10 }, "plugin": 7,
  "actors": { "1": "Alice", "6": "Sam (sweeper)" },
  "env": { "inception": [11], "quorum": [], "duplicity": [] },
  "steps": [
    { "now": 0, "actor": "anyone", "as": "Alice", "action": { "contribute": { "aid": 11, "owner": 1, "submittedAt": 0 } }, "expect": { "ok": true } },
    { "now": 25, "actor": "owner", "as": "Alice — too late to retract", "action": { "retract": { "req": 0 } }, "expect": { "ok": false, "reason": "not-in-phase-2" }, "exhibits": ["R9"] },
    { "now": 25, "actor": "anyone", "as": "Sam", "action": { "fold": { "folder": 6, "gen": 0, "plugin": 7, "batch": [{ "id": 0, "do": "reject" }] } },
      "expect": { "ok": true, "flow": { "refunds": [{ "addr": 1, "value": 1000 }], "tips": { "addr": 6, "value": 2 } } }, "exhibits": ["R9", "R11", "R6"] }
  ],
  "expectFinal": { "gen": 1, "plugin": 7, "root": [], "live": [], "tomb": [], "requests": [], "nextReq": 1 }
