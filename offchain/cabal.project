-- ----------------------------------------------------------------------
-- cardano-node-clients owns the `devnet` public sublibrary
-- (Cardano.Node.Client.E2E.Setup.withDevnet) used by the offchain/e2e
-- live-boundary smoke. Immutable pin; the rev matches the flake source
-- input used for E2E_GENESIS_DIR (they MUST agree). cardano-node itself
-- is a flake RUNTIME input (the node binary) only — never a Cabal
-- source-repository-package. The Cardano ledger/node LIBRARY versions
-- stay resolved from CHaP under the constraints block below.
-- ----------------------------------------------------------------------
source-repository-package
  type: git
  location: https://github.com/lambdasistemi/cardano-node-clients
  tag: 5877c54ab23e876292ccb1eabb89d85c6560eda2
  --sha256: 10wv1b5p4mbm911f08nry2f271qj3x7rh8ncabv6svwjnpvwlkzl

source-repository-package
  type: git
  location: https://github.com/lambdasistemi/cardano-tx-tools
  tag: 3940d17476324d705be2b49181a6ed881ba95393
  --sha256: 16x952r9qxpzppgxnbqa5yavscbw581y6csz5fdc55n88257qsmx

-- ----------------------------------------------------------------------
-- Git-only transitive dep of the FULL cardano-tx-tools library (the one
-- exposing Cardano.Tx.Validate, built with +build-node-tools below).
-- github-release-check is on neither hackage nor CHaP; cardano-tx-tools
-- supplies it to itself via its own cabal.project, and a consumer does
-- not inherit a dependency's source-repository-package stanzas. Mirrored
-- verbatim at the rev cardano-tx-tools pins at 3940d174, exactly as the
-- node-clients transitive block below is mirrored. Adds a package; changes
-- no existing pin.
-- ----------------------------------------------------------------------
source-repository-package
  type: git
  location: https://github.com/lambdasistemi/github-release-check
  tag: d90131112a4d6c048d1809adaffdefed92e8e841
  --sha256: 0ad6yi431w8h5i3x9x661b99frcgvd39gm4164y8cx1ihpsjixn3

-- ----------------------------------------------------------------------
-- Transitive git deps of cardano-node-clients. Mirrored verbatim from
-- the proven cardano-tx-tools pin set so cabal can resolve a build plan
-- without pulling these from elsewhere.
-- ----------------------------------------------------------------------
source-repository-package
  type: git
