//// INV-BIND: the grammar rows of the event object and of its anchor array, on exact bytes shared with
//// the Haskell reader (`inv_bind_grammar.json`). Generated by scripts/inv-bind-grammar-rows.mjs: do not edit. Every
//// single-error JSON row has its declared length fixed up, except the size-mismatch row. An accept row is bound by
//// the registration binder, a refuse row is not.

use cardano_keri/checkpoint/registration.{
  RegistrationEvidence, RegistrationValid, event_binding,
}
use cardano_keri/checkpoint/registration_vectors as vec
use cardano_keri/checkpoint/spelling_fixture

const obj_1_body: ByteArray =
  #""

const obj_2_body: ByteArray =
  #""

const obj_3_body: ByteArray =
  #""

const obj_4_body: ByteArray =
  #""

const anch_1_body: ByteArray =
  #""

const anch_2_body: ByteArray =
  #""

const anch_3_body: ByteArray =
  #""

const anch_4a_body: ByteArray =
  #""

const anch_4b_body: ByteArray =
  #""

const anch_5a_body: ByteArray =
  #""

const anch_5b_body: ByteArray =
  #""

const anch_6a_body: ByteArray =
  #""

const anch_6b_body: ByteArray =
  #""

fn row_binds(bytes: ByteArray) -> Bool {
  event_binding(
    vec.pos_2key_datum,
    spelling_fixture.of_view(vec.pos_2key_datum),
    RegistrationEvidence { ..vec.pos_2key_evidence, event_bytes: bytes },
  ) == RegistrationValid
}

test grammar_obj_1_accepts() {
  row_binds(obj_1_body)
}

test grammar_obj_2_refuses() {
  !row_binds(obj_2_body)
}

test grammar_obj_3_refuses() {
  !row_binds(obj_3_body)
}

test grammar_obj_4_refuses() {
  !row_binds(obj_4_body)
}

test grammar_anch_1_accepts() {
  row_binds(anch_1_body)
}

test grammar_anch_2_accepts() {
  row_binds(anch_2_body)
}

test grammar_anch_3_refuses() {
  !row_binds(anch_3_body)
}

test grammar_anch_4a_refuses() {
  !row_binds(anch_4a_body)
}

test grammar_anch_4b_refuses() {
  !row_binds(anch_4b_body)
}

test grammar_anch_5a_refuses() {
  !row_binds(anch_5a_body)
}

test grammar_anch_5b_refuses() {
  !row_binds(anch_5b_body)
}

test grammar_anch_6a_refuses() {
  !row_binds(anch_6a_body)
}

test grammar_anch_6b_refuses() {
