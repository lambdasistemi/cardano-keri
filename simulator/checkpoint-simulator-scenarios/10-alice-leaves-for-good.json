            "verdict": "not-present",
            "exhibits": [
              "T1",
              "T16",
              "T2",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          }
        },
        {
          "slot": 20,
          "who": "friend",
          "say": "The registry row stays: this AID can never be registered on Cardano again.",
          "action": {
            "register": {
              "refund": 1,
              "pool0": 10
            }
          },
          "expect": {
            "ok": false,
            "reason": "closed-needs-reopen",
            "verdict": "not-present",
            "exhibits": [
              "T7",
              "T8",
              "T9"
            ]
          }
        }
      ]
    },
    {
      "id": "relayer-close",
      "at": 3,
      "title": "A relayer with the public rotation tries to close",
      "steps": [
        {
          "slot": 20,
          "who": "hal",
          "say": "Hal holds Alice's next public rotation. A close needs more than public data: the new keys must sign the close intent (D-038). Refused.",
          "evidence": {
            "add": [
              {
                "rotationTo": [
                  1,
                  1,
                  2
                ]
              }
            ]
          },
          "action": {
            "close": {
              "sn'": 2,
              "refund'": null
            }
          },
          "expect": {
            "ok": false,
            "reason": "intent-not-authorized",
            "verdict": "consumable",
            "exhibits": [
              "T7",
              "T9"
            ]
          }
        },
        {
          "slot": 20,
          "who": "hal",
          "say": "A reopen on a live checkpoint is refused: only a closed tombstone reopens.",
          "action": {
            "reopen": {
              "sn'": 2,
              "refund": 2,
              "pool0": 10
            }
          },
          "expect": {
            "ok": false,
            "reason": "reopen-needs-closed",
            "verdict": "consumable",
            "exhibits": [
              "T7",
              "T8",
              "T9"
            ]
          }
        }
      ]
    },
    {
      "id": "reopen",
      "at": 4,
      "title": "Alice comes back: the tombstone is not terminal",
      "steps": [
        {
          "slot": 30,
          "who": "friend",
          "say": "A registration is refused: the registry leaf is closed, not absent. Only a reopen brings this AID back.",
          "action": {
            "register": {
              "refund": 1,
              "pool0": 10
            }
          },
          "expect": {
            "ok": false,
            "reason": "closed-needs-reopen",
            "verdict": "not-present",
            "exhibits": [
              "T7",
              "T8",
              "T9"
            ]
          }
        },
        {
          "slot": 30,
          "who": "mallory",
          "say": "A stale resurrection is refused: a reopen must present a rotation later than the tombstone’s sequence.",
          "evidence": {
            "add": [
              {
                "rotationTo": [
                  2,
                  2,
                  2
                ]
              }
            ]
          },
          "action": {
            "reopen": {
              "sn'": 2,
              "refund": 4,
              "pool0": 10
            }
          },
          "expect": {
            "ok": false,
            "reason": "sequence-not-later",
            "verdict": "not-present",
            "exhibits": [
              "T7",
              "T8",
              "T9"
