//// Cross-language parity proof for the #254 shared migration types
//// (S254-1A). Every constant compared here is produced by the Haskell
//// generator `offchain/app/GenMigrationTypesVectors.hs` and lands in
//// `types_vectors.ak`, which is never hand edited; `just
//// check-migration-types-vectors` fails on drift. This file is the Aiken
//// half of the proof: an independent encoder must reproduce those exact
//// bytes, and must decode them back into the same typed value.
////
//// Every input fixture is also generated, so the two languages provably
//// encode the *same* material — a hand-copied fixture here could silently
//// make the comparison assert Aiken against Aiken.
////
//// The golden authorization deliberately carries a `source_role` that
//// differs from its `target_role`. That is not a claim that such a
//// migration is legal — INV-254-IDENTITY forbids changing the live role —
//// it is what makes a swap of the two positions detectable at the wire
//// level. Whether the two must be equal is a later validation rule, not a
//// wire-shape rule.

use aiken/cbor
use aiken/collection/list
use cardano/address.{Address, Inline, Pointer, Script, VerificationKey}
use cardano/transaction.{OutputReference}
use cardano_keri/migration/types.{
  Board, CheckpointActive, CheckpointArmed, CheckpointFrozen,
  MigrationAuthorization, MigrationPredecessor, MigrationTarget,
  migration_domain,
}
use cardano_keri/migration/types_vectors as vec

// ---------------------------------------------------------
// Fixtures — every byte string comes from the generator
// ---------------------------------------------------------

fn source_ref() -> OutputReference {
  OutputReference { transaction_id: vec.fixture_source_txid, output_index: 3 }
}

fn predecessor() -> MigrationPredecessor {
  MigrationPredecessor {
    predecessor_policy: vec.fixture_source_policy,
    predecessor_ref: source_ref(),
  }
}

fn target_address() -> Address {
  Address {
    payment_credential: Script(vec.fixture_target_payment_script),
    stake_credential: Some(Inline(Script(vec.fixture_target_stake_script))),
  }
}

fn refund_address() -> Address {
  Address {
    payment_credential: VerificationKey(vec.fixture_refund_vkey),
    stake_credential: None,
  }
}

fn pointer_address() -> Address {
  Address {
    payment_credential: VerificationKey(vec.fixture_pointer_vkey),
    stake_credential: Some(
      Pointer { slot_number: 7, transaction_index: 2, certificate_index: 1 },
    ),
  }
}

fn target() -> MigrationTarget {
  MigrationTarget {
    target_policy: vec.fixture_target_policy,
    target_role: CheckpointActive,
    target_address: target_address(),
    legacy_refund_address: Some(refund_address()),
  }
}

fn target_no_refund() -> MigrationTarget {
  MigrationTarget {
    ..target(),
    target_address: Address {
      payment_credential: Script(vec.fixture_target_payment_script),
      stake_credential: None,
    },
    legacy_refund_address: None,
  }
}

fn target_pointer_stake() -> MigrationTarget {
  MigrationTarget { ..target(), target_address: pointer_address() }
}

/// The source validator's own projected state, carried verbatim. Decoding
/// the generated bytes (rather than rebuilding a typed value here) is the
/// point: the protocol layer never interprets this payload.
fn state() -> Data {
  expect Some(payload) = cbor.deserialise(vec.golden_source_state)
  payload
}

fn mutant_state() -> Data {
  expect Some(payload) = cbor.deserialise(vec.mutant_source_state)
  payload
}

fn authorization() -> MigrationAuthorization {
  MigrationAuthorization {
    domain: migration_domain,
    network_id: 1,
    source: predecessor(),
    source_role: CheckpointFrozen,
    source_state: state(),
    target: target(),
    controller_signatures: [(0, vec.fixture_sig_a), (2, vec.fixture_sig_b)],
  }
}

// ---------------------------------------------------------
// Byte identity against the Haskell encoder
// ---------------------------------------------------------

test domain_matches_haskell() {
  migration_domain == vec.golden_migration_domain
}

/// The lifecycle vocabulary is protocol surface: each role is a distinct
/// constructor, so a role can never be confused with another on the wire.
test role_bytes_match_haskell() {
  and {
    cbor.serialise(CheckpointActive) == vec.golden_role_checkpoint_active,
    cbor.serialise(CheckpointFrozen) == vec.golden_role_checkpoint_frozen,
    cbor.serialise(CheckpointArmed) == vec.golden_role_checkpoint_armed,
    cbor.serialise(Board) == vec.golden_role_board,
  }
}

test roles_are_pairwise_distinct() {
  let encodings = [
    vec.golden_role_checkpoint_active,
    vec.golden_role_checkpoint_frozen,
    vec.golden_role_checkpoint_armed,
    vec.golden_role_board,
  ]
  list.length(list.unique(encodings)) == 4
}

/// DAT-254-PREDECESSOR: the exact policy and output a migration consumes.
/// There is no generation and no back-pointer: the spend is the edge.
test predecessor_bytes_match_haskell() {
  cbor.serialise(predecessor()) == vec.golden_predecessor
}

test target_bytes_match_haskell() {
  and {
    cbor.serialise(target()) == vec.golden_target,
    cbor.serialise(target_no_refund()) == vec.golden_target_no_refund,
    cbor.serialise(target_pointer_stake()) == vec.golden_target_pointer_stake,
  }
}

test source_state_is_carried_verbatim() {
  cbor.serialise(state()) == vec.golden_source_state
}

test authorization_bytes_match_haskell() {
  cbor.serialise(authorization()) == vec.golden_authorization
}

/// INV-254-IDENTITY: the Haskell bytes decode back into exactly the typed
/// value, so no field is dropped, reordered, or summarised on the way.
test authorization_decodes_from_haskell_bytes() {
  expect Some(payload) = cbor.deserialise(vec.golden_authorization)
  expect parsed: MigrationAuthorization = payload
  parsed == authorization()
}

/// INV-254-AUTHORITY: a controller index is an unbounded ledger integer, so a
/// mirror narrowing it to a machine word aliases 2^63 to -2^63. Both languages
/// must agree on the wide value, and the alias must stay a distinct encoding.
test wide_controller_index_is_not_narrowed() {
  let sigs = [(0, vec.fixture_sig_a), (9223372036854775808, vec.fixture_sig_b)]
  let wide = MigrationAuthorization {
    ..authorization(),
    controller_signatures: sigs,
  }
  and {
    cbor.serialise(wide) == vec.golden_auth_wide_index,
    vec.golden_auth_wide_index != vec.negative_auth_wide_index_narrowed,
  }
}

// ---------------------------------------------------------
// Named field mutations — INV-254-REPLAY negative controls
// ---------------------------------------------------------

/// One mutation per redirectable field, in the same order as the generator.
fn mutations() -> List<ByteArray> {
  let auth = authorization()
  [
    cbor.serialise(
      MigrationAuthorization { ..auth, domain: vec.fixture_mutant_domain },
    ),
    cbor.serialise(MigrationAuthorization { ..auth, network_id: 0 }),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        source: MigrationPredecessor {
          ..predecessor(),
          predecessor_policy: vec.fixture_target_policy,
        },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        source: MigrationPredecessor {
          ..predecessor(),
          predecessor_ref: OutputReference {
            ..source_ref(),
            transaction_id: vec.fixture_mutant_txid,
          },
        },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        source: MigrationPredecessor {
          ..predecessor(),
          predecessor_ref: OutputReference { ..source_ref(), output_index: 4 },
        },
      },
    ),
    cbor.serialise(MigrationAuthorization { ..auth, source_role: Board }),
    cbor.serialise(
      MigrationAuthorization { ..auth, source_state: mutant_state() },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        target: MigrationTarget {
          ..target(),
          target_policy: vec.fixture_source_policy,
        },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        target: MigrationTarget { ..target(), target_role: CheckpointFrozen },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        target: MigrationTarget {
          ..target(),
          target_address: Address { ..target_address(), stake_credential: None },
        },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        target: MigrationTarget { ..target(), legacy_refund_address: None },
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        controller_signatures: [(1, vec.fixture_sig_a), (2, vec.fixture_sig_b)],
      },
    ),
    cbor.serialise(
      MigrationAuthorization {
        ..auth,
        controller_signatures: [(2, vec.fixture_sig_b), (0, vec.fixture_sig_a)],
      },
    ),
  ]
}

fn generated_mutations() -> List<ByteArray> {
  [
    vec.negative_auth_domain_mutated,
    vec.negative_auth_network_mutated,
    vec.negative_auth_source_policy_crossed,
    vec.negative_auth_source_ref_txid_mutated,
    vec.negative_auth_source_ref_index_bumped,
    vec.negative_auth_source_role_board,
    vec.negative_auth_source_state_mutated,
    vec.negative_auth_target_policy_crossed,
    vec.negative_auth_target_role_swapped,
    vec.negative_auth_target_address_stake_dropped,
    vec.negative_auth_refund_dropped,
    vec.negative_auth_signature_index_bumped,
    vec.negative_auth_signatures_reordered,
  ]
}

test authorization_mutations_match_haskell() {
  mutations() == generated_mutations()
}

/// Every named mutation changes the bytes, and no two of them collide: the
/// authorization binds each redirectable field at its own position.
test authorization_mutations_are_pairwise_distinct() {
  let all = [vec.golden_authorization, ..generated_mutations()]
  list.length(list.unique(all)) == list.length(all)
}
