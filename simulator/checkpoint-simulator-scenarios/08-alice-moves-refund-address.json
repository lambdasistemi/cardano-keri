{
  "story": 8,
  "title": "Alice moves her refund address",
  "goal": "As Alice, I want the money to come back to me and not to whoever registered my checkpoint.",
  "params": {
    "D": 1000,
    "B": 5,
    "P": 2,
    "W": 10
  },
  "steps": [
    {
      "slot": 0,
      "who": "friend",
      "say": "A stranger registered Alice’s checkpoint with his own refund address (6).",
      "action": {
        "register": {
          "refund": 6,
          "pool0": 10
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "refundTo": 6
        },
        "verdict": "juvenile",
        "exhibits": [
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "Alice rotates on KERI. A relayer submits her public rotation asking to move the refund address to Alice’s: the new keys did not sign the address, so the rotation is refused as submitted.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              0,
              0,
              1
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "keep",
          "payee": 2,
          "refund'": 1
        }
      },
      "expect": {
        "ok": false,
        "reason": "intent-not-authorized",
        "verdict": "consumable",
        "exhibits": [
          "T7",
          "T9"
        ]
      }
    },
    {
      "slot": 12,
      "who": "hal",
      "say": "The same relayer submits the rotation with no address at all: it lands, and the refund address stays the stranger’s.",
      "action": {
        "rotate": {
          "sn'": 1,
          "op": "keep",
          "payee": 2,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "sn": 1,
          "epoch": 1,
          "refundTo": 6,
          "dreg": 1000,
          "b": 5,
          "pool": 8
        },
        "flow": {
          "hunter": {
            "addr": 2,
            "dreg": 0,
            "b": 0,
            "pool": 2
          }
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "At her next rotation Alice’s new keys (epoch 2) sign her address along with the rotation. The address moves.",
      "evidence": {
        "add": [
          {
            "rotationTo": [
              1,
              1,
              2
            ]
          },
          {
            "intentAuthorized": [
              2,
              "keep",
              1
            ]
          }
        ]
      },
      "action": {
        "rotate": {
          "sn'": 2,
          "op": "keep",
          "payee": 1,
          "refund'": 1
        }
      },
      "expect": {
        "ok": true,
        "live": {
          "sn": 2,
          "epoch": 2,
          "refundTo": 1,
          "dreg": 1000,
          "b": 5,
          "pool": 6
        },
        "flow": {
          "hunter": {
            "addr": 1,
            "dreg": 0,
            "b": 0,
            "pool": 2
          }
        },
        "verdict": "consumable",
        "exhibits": [
          "T1",
          "T2",
          "T3",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9",
          "T14",
          "T16"
        ]
      }
    },
    {
      "slot": 12,
      "who": "alice",
      "say": "At close the stranger’s bonds go to Alice: a stale registration is a donation.",
      "evidence": {
        "add": [
          {
            "quorum": [
              2
            ]
          },
          {
            "rotationTo": [
              2,
              2,
              3
            ]
          },
          {
            "intentAuthorized": [
              3,
              "close",
              null
            ]
          }
        ]
      },
      "action": {
        "close": {
          "sn'": 3,
          "refund'": null
        }
      },
      "expect": {
        "ok": true,
        "state": {
          "closed": {
            "epoch": 3,
            "sn": 3
          }
        },
        "flow": {
          "refund": {
            "addr": 1,
            "dreg": 1000,
            "b": 5,
            "pool": 6
          }
        },
        "verdict": "not-present",
        "exhibits": [
          "T1",
          "T16",
          "T2",
          "T5",
          "T6",
          "T7",
          "T8",
          "T9"
        ]
      }
    }
  ],
  "forks": [
    {
      "id": "unrelated-intent",
      "at": 2,
      "title": "a signed withdrawal is not a signed address",
      "steps": [
        {
          "who": "alice",
          "slot": 12,
          "evidence": {
            "add": [
              {
                "rotationTo": [
                  1,
                  1,
                  2
                ]
              },
              {
                "intentAuthorized": [
                  2,
                  "withdraw",
                  null
                ]
              }
            ]
          },
          "say": "Alice rotates again and her new keys (epoch 2) sign a withdrawal, no address named."
        },
        {
          "who": "hal",
          "slot": 12,
          "action": {
            "rotate": {
              "sn'": 2,
              "op": "keep",
              "payee": 2,
              "refund'": 1
            }
          },
          "expect": {
            "ok": false,
            "reason": "intent-not-authorized",
            "exhibits": [
              "T7",
              "T9"
            ]
          },
          "say": "A relayer lands the rotation as a keep asking to move the refund address to Alice. The message her keys signed is a withdrawal without an address, not this rotation’s option with this address: refused (T6_refund_change_requires_new_keys, D-038)."
        },
        {
          "who": "hal",
          "slot": 12,
          "action": {
            "rotate": {
              "sn'": 2,
              "op": "withdraw",
              "payee": 2,
              "refund'": null
            }
          },
          "expect": {
            "ok": true,
            "live": {
              "refundTo": 6
            },
            "exhibits": [
              "T1",
              "T14",
              "T15",
              "T16",
              "T2",
              "T3",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          },
          "say": "The signed message itself lands: the withdrawal, and the address stays the stranger’s."
        }
      ]
    }
  ]
}
