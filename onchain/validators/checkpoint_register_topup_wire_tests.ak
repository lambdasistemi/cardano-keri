//// #522 — the Haskell encoders and the Aiken types agree on the bytes of the
//// bounded top-up: the TopUp spend redeemer (spend constructor four) and the
//// live datum with the top-up mark clear and set.
////
//// The expected bytes are generated by `offchain/app/GenTopUpVectors.hs`, never
//// written by hand; the typed value serialises to exactly what the Haskell
//// encoder computed, or the field order, a constructor index or the Boolean
//// shape disagrees between the layers.

use aiken/cbor
use cardano_keri/checkpoint/datum
use cardano_keri/checkpoint/topup_vectors as vec
use checkpoint_register

test top_up_spend_redeemer_is_the_haskell_encoding() {
  let redeemer: Data = checkpoint_register.TopUp { amount: vec.amount }
  cbor.serialise(redeemer) == vec.spend_redeemer_cbor
}

test top_up_redeemer_reads_back_as_the_amount() {
  expect checkpoint_register.TopUp { amount } = {
    let data: Data = checkpoint_register.TopUp { amount: vec.amount }
    data
  }
  amount == vec.amount
}

test live_datum_with_the_mark_clear_is_the_haskell_encoding() {
  cbor.serialise(datum.write(vec.live_clear)) == vec.live_clear_cbor
}

test live_datum_with_the_mark_set_is_the_haskell_encoding() {
  cbor.serialise(datum.write(vec.live_marked)) == vec.live_marked_cbor
}

test the_two_datums_differ_only_in_the_mark() {
  vec.live_clear_cbor != vec.live_marked_cbor && vec.live_clear != vec.live_marked
}

test the_typed_datums_round_trip_through_the_writer_and_the_reader() {
  let clear: Data = datum.write(vec.live_clear)
  let marked: Data = datum.write(vec.live_marked)
  datum.read(clear) == vec.live_clear && datum.read(marked) == vec.live_marked
}
