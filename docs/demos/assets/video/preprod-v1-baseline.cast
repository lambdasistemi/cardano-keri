[140.60169, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mAlice closes and reads back\u001b[0m\r\n\r\n\u001b[0;90m# ckeri submits the signed close; status must no longer find an active checkpoint.\u001b[0m\r\n\r\n\u001b[1;32m$ ckeri close --aid EJ_VgFPrdc-VOWwvwmBMV8cU18FvP_BimhGOf9euRnsg --controller-signatures close-signatures.cesr\u001b[0m\r\n"]
