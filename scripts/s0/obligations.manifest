# S0 source-to-obligation manifest (S0-F10 / S0-I03 / S0-T05)
# Fields are TAB-separated: obligation, relative path, ERE pattern.
# Patterns are matched after // comment lines are stripped.
# Supplementary completeness map only — reachability is check-reachability.sh.
S0-M01-types	onchain/lib/cardano_keri/m12/types.ak	pub[[:space:]]+type[[:space:]]+ParsedEvent
S0-M02-handler	onchain/validators/s0_append.ak	validator[[:space:]]+s0_append
S0-M02-reachability	onchain/validators/s0_append.ak	apply_record_append[[:space:]]*\(
S0-M03-handler	onchain/validators/s0_cursor.ak	validator[[:space:]]+s0_cursor
S0-M03-reachability	onchain/validators/s0_cursor.ak	derive_cursor[[:space:]]*\(
S0-M04-handler	onchain/validators/s0_lineage.ak	validator[[:space:]]+s0_lineage
S0-M04-reachability	onchain/validators/s0_lineage.ak	validate_lineage_transition[[:space:]]*\(
S0-M05-handler	onchain/validators/s0_maintenance_escrow.ak	validator[[:space:]]+s0_maintenance_escrow
S0-M05-reachability	onchain/validators/s0_maintenance_escrow.ak	validate_escrow_transition[[:space:]]*\(
S0-M06-handler	onchain/validators/s0_staging_proof_token.ak	validator[[:space:]]+s0_staging_proof_token
S0-M06-reachability	onchain/validators/s0_staging_proof_token.ak	validate_staging_token[[:space:]]*\(
S0-M08-handler	onchain/validators/s0_consumer_predicates.ak	validator[[:space:]]+s0_consumer_predicates
S0-M08-reachability	onchain/validators/s0_consumer_predicates.ak	cursor_policy_allows[[:space:]]*\(
S0-M09-handler	onchain/validators/s0_reference_cursor_consumer.ak	validator[[:space:]]+s0_reference_cursor_consumer
S0-M09-reachability	onchain/validators/s0_reference_cursor_consumer.ak	validate_reference_consumer[[:space:]]*\(
S0-F01-defined	onchain/lib/cardano_keri/m12/record.ak	pub[[:space:]]+fn[[:space:]]+bind_parsed_event[[:space:]]*\(
S0-F02-defined	onchain/lib/cardano_keri/m12/record.ak	pub[[:space:]]+fn[[:space:]]+apply_record_append[[:space:]]*\(
