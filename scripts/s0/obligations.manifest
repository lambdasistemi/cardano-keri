S0-M02-event-binding	onchain/lib/cardano_keri/m12/record.ak	(said|blake2b_256|sha2_256|verify)
S0-F03-defined	onchain/lib/cardano_keri/m12/cursor.ak	pub[[:space:]]+fn[[:space:]]+derive_cursor[[:space:]]*\(
S0-M03-history-proof	onchain/lib/cardano_keri/m12/cursor.ak	(proof|mpf\.|including|from_root)
S0-F04-defined	onchain/lib/cardano_keri/m12/lineage.ak	pub[[:space:]]+fn[[:space:]]+validate_lineage_transition[[:space:]]*\(
S0-M04-context	onchain/lib/cardano_keri/m12/lineage.ak	(inputs|reference_inputs|validity_range|OutputReference)
S0-M04-roots	onchain/lib/cardano_keri/m12/lineage.ak	(event_root|occupancy_root)
S0-M04-flags	onchain/lib/cardano_keri/m12/lineage.ak	(closed|cursor)
S0-F05-defined	onchain/lib/cardano_keri/m12/escrow.ak	pub[[:space:]]+fn[[:space:]]+validate_escrow_transition[[:space:]]*\(
S0-M05-value-time	onchain/lib/cardano_keri/m12/escrow.ak	(outputs|validity_range|Value|lovelace)
S0-F06-defined	onchain/lib/cardano_keri/m12/staging.ak	pub[[:space:]]+fn[[:space:]]+validate_staging_token[[:space:]]*\(
