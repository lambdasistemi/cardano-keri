//// Generated from #589 first-seen and rival event bytes.

use cardano_keri/checkpoint/message.{qb64_aid}
use cardano_keri/checkpoint/rival_evidence.{RivalClaim, open_digest}
use cardano_keri/checkpoint/threshold.{Unweighted}

test d09_accepted_opens_own_said() {
  let claim = RivalClaim {
    aid: #"e1959bf2de02c8899476d1e521542e20c6f12ef9f31aefb78749111baacf35e1",
    sn: 1,
    prior: "EOGVm_LeAsiJlHbR5SFULiDG8S758xrvt4dJERuqzzXh",
    cur_keys: [
      #"e2f81df14b0a6e8b7636a78fbcfa7da965007aa2fc27992186b8b7083e2e1dbb",
      #"7632dfc701d4adad1381bcf0c5668dd26d582f08b7aacbe634968c6a74ce79bb",
    ],
    cur_threshold: Unweighted(2),
    next_keys: [
      #"4be83b966b481acb58993cc37b8257b6ac44f38352ddcc739045553208ce1d9a",
      #"c4816ae1023b38ee9c80c8630d6e151b904ff6b7d4fcf38146129974ab2b15e7",
    ],
    next_threshold: Unweighted(2),
    toad: 0,
    cuts: [],
    adds: [],
  }
  when
    open_digest(
      claim,
      #"",
    )
  is {
    Some(digest) ->
      qb64_aid(digest) == "EB1p5urcirq4ySrkSvE4nkwpTJc9QjrMfOsvVyKdDDvc"
    None -> False
  }
}

