/// Requirements row frozen-required: the required intent for a frozen checkpoint: accepted.
test requirement_frozen_required() {
  candidate_taken(0)
}

/// Requirements row unfrozen-required: the required intent for an unfrozen checkpoint, naming 0: accepted.
test requirement_unfrozen_required() {
  candidate_taken(1)
}

/// Requirements row poisoned-required: the required intent for a frozen, poisoned checkpoint: accepted.
test requirement_poisoned_required() {
  candidate_taken(2)
}

/// Requirements row domain-v2: another version of the domain tag.
test requirement_domain_v2() fail {
  candidate_taken(3)
}

/// Requirements row domain-other-protocol: another protocol's domain tag.
test requirement_domain_other_protocol() fail {
  candidate_taken(4)
}

/// Requirements row other-network: the intent for network 1 presented on network 0.
test requirement_other_network() fail {
  candidate_taken(5)
}

/// Requirements row other-policy: another checkpoint policy.
test requirement_other_policy() fail {
  candidate_taken(6)
}

/// Requirements row other-transaction: an output of another transaction.
