        },
        {
          "slot": 30,
          "who": "alice",
          "say": "Alice rotates on KERI again; her witnesses receipt sequence 3. She reopens with fresh bonds: born again, juvenile, at the next epoch.",
          "evidence": {
            "add": [
              {
                "rotationTo": [
                  2,
                  2,
                  3
                ]
              }
            ]
          },
          "action": {
            "reopen": {
              "sn'": 3,
              "refund": 1,
              "pool0": 10
