{"version": 2, "width": 80, "height": 24, "timestamp": 1790188492, "idle_time_limit": 3.0, "env": {"SHELL": "/run/current-system/sw/bin/bash", "TERM": "dumb"}, "title": "Cardano KERI preprod V1 baseline: keripy and ckeri"}
[0.110507, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mPreprod V1 | release and network\u001b[0m\r\n\r\n\u001b[0;90m# This is the deployed V1 checkpoint, not the planned Singular registry.\u001b[0m\r\n\r\n\u001b[1;32m$ ckeri manifest verify --manifest m1-manifest.json --koios-url preprod\u001b[0m\r\n"]
[0.45649, "o", "on-chain checkpoint-register: OK 8a1a404f13b50ec0a266e1427f602916d830b62d757f3ac69976ccba0213c5d1#0\r\nmanifest verify: OK — rebuilt from source; all hashes and on-chain references are live\r\n"]
[0.457148, "o", "\u001b[1;32m$ ckeri --version\u001b[0m\r\n"]
[0.472144, "o", "ckeri 0.4.0 \r\n"]
[0.475014, "o", "\u001b[1;32m$ kli version\u001b[0m\r\n"]
[1.546288, "o", "Library version: 1.3.5\r\n"]
[4.342681, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mAlice creates a KERI identifier\u001b[0m\r\n\r\n\u001b[0;90m# Keripy owns the keys. The AID and CESR export are fresh for this run.\u001b[0m\r\n\r\n"]
[4.366888, "o", "\u001b[1;32m$ kli init --name alice --base ckeri-preprod-demo-nApvVR --nopasscode\u001b[0m\r\n"]
[5.412255, "o", "KERI Keystore created at: /var/lib/keri/.keri/ks/ckeri-preprod-demo-nApvVR/alice\r\nKERI Database created at: /var/lib/keri/.keri/db/ckeri-preprod-demo-nApvVR/alice\r\nKERI Credential Store created at: /var/lib/keri/.keri/reg/ckeri-preprod-demo-nApvVR/alice\r\n"]
[5.63915, "o", "\u001b[1;32m$ kli incept --name alice --base ckeri-preprod-demo-nApvVR --alias alice --transferable --icount 1 --isith 1 --ncount 1 --nsith 1 --toad 0\u001b[0m\r\n"]
