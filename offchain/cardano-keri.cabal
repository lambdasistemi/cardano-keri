cabal-version: 3.4
name:          cardano-keri
version:       0.4.0
synopsis:
  Haskell library for KERI-AID identity operations and cage validator types

description:
  Pure Haskell implementation of KERI Ed25519 verification, CESR
  encoding/decoding, and PlutusData types matching the cardano-keri
  extended cage validator (AIDOwnerAuth, AIDRequestAction, AIDOnChainTokenState).

license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple

-- Committed keripy oracle fixtures, read hermetically by the unit-tests
-- Keri68OracleSpec via Paths_cardano_keri (getDataFileName).
data-files:
  deployment-test/fixtures/*.cesr
  docs/assets/swagger/query-api.json
  indexer-test/fixtures/*.json
  test/keri-fixtures/fixtures/*.json

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   lib e2e
  build-depends:
    , base                  >=4.18 && <5
    , bytestring            >=0.11 && <0.13
    , cardano-crypto-class
    , containers
    , memory                >=0.18 && <0.19
    , plutus-core
    , plutus-tx
    , text

  exposed-modules:
    Cardano.KERI.AID.Blake3.Checkpoint
    Cardano.KERI.AID.Cage.Sign
    Cardano.KERI.AID.Cage.Types
    Cardano.KERI.AID.CESR
    Cardano.KERI.AID.Checkpoint.Advance
    Cardano.KERI.AID.Checkpoint.Close
    Cardano.KERI.AID.Checkpoint.Datum
    Cardano.KERI.AID.Checkpoint.Enforcement
    Cardano.KERI.AID.Checkpoint.FreezeBond
    Cardano.KERI.AID.Checkpoint.LifecycleModel
    Cardano.KERI.AID.Checkpoint.Message
    Cardano.KERI.AID.Checkpoint.Registration
    Cardano.KERI.AID.Checkpoint.Threshold
    Cardano.KERI.AID.Checkpoint.Wire
    Cardano.KERI.AID.Ed25519

  other-modules:
    Cardano.KERI.AID.E2E.Mpf
    Cardano.KERI.AID.E2E.MpfProof
    Cardano.KERI.AID.E2E.MpfTrie

-- #257: provider-neutral chain-query algebra. Owns the minimal free query
-- program, locators, promoted shared result types, watermark, and errors.
-- No HTTP, RocksDB, node runtime, URL, token, or executable-setting
-- responsibility (MOD-257-QUERY). See specs/257-query-algebra/plan.md.
library chain-query
  import:           warnings
  visibility:       public
  default-language: GHC2021
  hs-source-dirs:   query
  build-depends:
    , aeson
    , base                   >=4.18 && <5
    , bech32
    , bytestring             >=0.11 && <0.13
    , cardano-crypto-class
    , cardano-keri
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , containers
    , memory                 >=0.18 && <0.19
    , microlens
    , plutus-core
    , text
    , time
    , transformers

  exposed-modules:
    Cardano.KERI.ChainQuery
    Cardano.KERI.ChainQuery.Interpreter
    Cardano.KERI.ChainQuery.LedgerOutput
    Cardano.KERI.ChainQuery.PlutusJson
    Cardano.KERI.ChainQuery.Program
    Cardano.KERI.ChainQuery.Registration
    Cardano.KERI.ChainQuery.Settlement
    Cardano.KERI.ChainQuery.Types

