test requirement_frozen_names_zero() fail {
  candidate_taken(12)
}

/// Requirements row frozen-names-less: a frozen checkpoint with an intent naming one lovelace less than the bond.
test requirement_frozen_names_less() fail {
  candidate_taken(13)
}

/// Requirements row frozen-names-more: a frozen checkpoint with an intent naming one lovelace more than the bond.
test requirement_frozen_names_more() fail {
  candidate_taken(14)
}

/// Requirements row unfrozen-names-bond: an unfrozen checkpoint with an intent naming the freeze bond.
test requirement_unfrozen_names_bond() fail {
  candidate_taken(15)
}

/// Authorizations row two-of-three: two of three new keys sign the required intent: the deposit is taken.
test authorization_two_of_three() {
  authorized(0)
}

/// Authorizations row three-of-three: all three new keys sign: the deposit is taken.
test authorization_three_of_three() {
  authorized(1)
}

/// Authorizations row one-of-three: one new key signs, below the threshold: refused.
test authorization_one_of_three() fail {
  authorized(2)
}

/// Authorizations row repeated-position: the same position twice counts once: refused.
test authorization_repeated_position() fail {
  authorized(3)
}

/// Authorizations row position-out-of-range: a signature at a position with no key never counts: refused.
test authorization_position_out_of_range() fail {
  authorized(4)
}

/// Authorizations row positions-swapped: each signature at the other key's position does not verify: refused.
test authorization_positions_swapped() fail {
  authorized(5)
}

/// Authorizations row old-keys: the keys of the spent epoch sign: refused.
test authorization_old_keys() fail {
  authorized(6)
}

/// Authorizations row signed-other-output: the new keys signed the intent for another output of the same transaction: refused.
test authorization_signed_other_output() fail {
  authorized(7)
}

/// Authorizations row signed-other-network: the new keys signed the intent for another network: refused.
test authorization_signed_other_network() fail {
  authorized(8)
}

/// Authorizations row signed-zero-on-frozen: the new keys signed an intent naming 0 for a frozen checkpoint: refused.
test authorization_signed_zero_on_frozen() fail {
  authorized(9)
}

/// Authorizations row one-stale-two-current: one signature over another output, two over the required intent: the deposit is taken.
test authorization_one_stale_two_current() {
  authorized(10)
}

/// Authorizations row weighted-two-halves: a weighted threshold of three halves, two keys sign: the deposit is taken.
test authorization_weighted_two_halves() {
  authorized(11)
}

/// Authorizations row weighted-one-half: a weighted threshold of three halves, one key signs: refused.
test authorization_weighted_one_half() fail {
  authorized(12)
}

/// Authorizations row unfrozen-zero: an unfrozen checkpoint, the new keys sign the intent naming 0: the deposit is taken and brings nothing.
test authorization_unfrozen_zero() {
  authorized(13)
}

/// Authorizations row unfrozen-signed-bond: an unfrozen checkpoint, the new keys sign an intent naming the freeze bond: refused.
test authorization_unfrozen_signed_bond() fail {
  authorized(14)
}
