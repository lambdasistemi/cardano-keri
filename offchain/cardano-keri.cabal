-- #257: the concrete Koios interpreter (MOD-257-KOIOS). Owns the legacy
-- Koios HTTP client, endpoint response decoding, configuration, operation
-- translation, and the explicit sequential/non-atomic consistency claim.
-- Depends downstream on chain-query and (for neutral decoders only, never
-- builder callbacks) on deployment; never on indexer.
library chain-query-koios
  import:           warnings
  visibility:       public
  default-language: GHC2021
  hs-source-dirs:   query-koios
  build-depends:
    , aeson
    , base                      >=4.18 && <5
    , bytestring                >=0.11 && <0.13
    , cardano-keri
    , cardano-keri:chain-query
    , cardano-keri:deployment
    , http-conduit
    , memory                    >=0.18 && <0.19
    , plutus-core
    , text

  exposed-modules:  Cardano.KERI.ChainQuery.Koios

-- #240 (MOD-240-WRITE-COMPOSITION): the provider-free write-composition
-- boundary. Owns every transaction-building write command (deploy/register/
-- advance/close/endpoint-board deploy-post-update-retire); obtains chain
-- state and observes settlement only through the local follower/indexer
-- tier ("indexer"), never "chain-query-koios"/http-conduit
-- (INV-240-NOPROVIDER). "cli" depends on this component, never the reverse
-- (EDGE-240-02) -- read-only manifest verification and endpoint-board
-- listing stay in "cli" via "Cardano.KERI.Deployment.Verify" instead
-- (EDGE-240-04). Formerly `Cardano.KERI.Deployment.CLI` living inside `cli`
-- (#257 MOD-257-COMPOSITION); relocated here so the component graph itself,
-- not a source convention, enforces the boundary (plan.md "Dependency
-- direction").
library write-composition
  import:           warnings
  visibility:       public
  default-language: GHC2021
  hs-source-dirs:   write-composition
  build-depends:
    , base                                       >=4.18 && <5
    , bytestring                                 >=0.11 && <0.13
    , cardano-keri
    , cardano-keri:chain-query
    , cardano-keri:deployment
    , cardano-keri:indexer
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-node-clients:utxo-indexer-lib
    , directory
    , opt-env-conf                               >=0.13 && <0.16
    , rocksdb-kv-transactions:kv-transactions
    , text
    , time

  exposed-modules:
    Cardano.KERI.Deployment.CLI

-- #177 Slice 1: the production `ckeri status` backend seam. Depends on both
-- `deployment` (Koios/manifest/endpoint-board reuse) and `indexer` (the local
-- transactional query engine) — acyclic since neither of those depends back
-- on this library. See specs/177-backends/plan.md.
-- #257 MOD-257-COMPOSITION: the downstream CLI component owns provider
-- construction/selection and registration orchestration.
-- #240: the write-command surface itself (formerly
-- Cardano.KERI.Deployment.CLI) now lives in "write-composition"
-- (EDGE-240-02); this component only composes it with its own read-only
-- backend seam and "Cardano.KERI.Deployment.Verify" (EDGE-240-04).
library cli
  import:           warnings
  visibility:       public
  default-language: GHC2021
  hs-source-dirs:   cli
  build-depends:
    , aeson
    , base
    , bytestring
    , cardano-keri
    , cardano-keri:chain-query
    , cardano-keri:chain-query-koios
    , cardano-keri:deployment
    , cardano-keri:indexer
    , cardano-keri:write-composition
    , cardano-node-clients:utxo-indexer-lib
    , directory
    , http-conduit
    , opt-env-conf                             >=0.13 && <0.16
    , rocksdb-kv-transactions:kv-transactions
    , stm
    , text

  exposed-modules:
    Cardano.KERI.CLI
    Cardano.KERI.CLI.Backend
    Cardano.KERI.CLI.Backend.Endpoint
    Cardano.KERI.CLI.Backend.Koios
    Cardano.KERI.CLI.Backend.Local
    Cardano.KERI.Deployment.Verify

